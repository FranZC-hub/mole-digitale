# Foto caricate dall'area riservata: qui dentro nessuno script deve poter girare,
# anche se qualcuno riuscisse a caricare un file con un nome furbo.
Options -Indexes -ExecCGI
<FilesMatch "\.(?i:php\d?|phtml|phar|pht|pl|py|cgi|sh|shtml|html?|js|svg|htaccess)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'none'; sandbox"
</IfModule>
