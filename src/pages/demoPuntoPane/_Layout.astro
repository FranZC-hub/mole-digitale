---
// BOZZA CLIENTE — PuntoPane (Cammino S.r.l.), laboratorio di panificazione, Torino
// Anteprima non ufficiale realizzata da Mole Digitale su dati pubblici e sulla loro richiesta.
//
// IMPIANTO VISIVO: il laboratorio, non la vetrina. Fondo color farina, carta kraft come quella
// dei sacchi e delle buste del pane, crosta bruciata come colore d'azione. Il «punto» del nome
// diventa il segno: il pallino del marchio, i numeri dei passaggi, il bollo tondo in copertina.
// Jost per i titoli (geometrico, da etichetta stampata), Plus Jakarta Sans per il testo.
import '@fontsource-variable/jost';
import '@fontsource-variable/plus-jakarta-sans';
import jostWoff2 from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import jakartaWoff2 from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import { INFO, BASE, CATEGORIE } from './_shared.js';

interface Props { title: string; desc?: string; active?: string }
const {
  title,
  desc = `${INFO.nome}, laboratorio di panificazione a Torino: pane a lievito madre con farine biologiche macinate a pietra, focacce, grissini e prodotti per la colazione. Fornitura all’ingrosso per ristoranti, bar, hotel e negozi.`,
  active = '',
} = Astro.props;

const pieno = active === 'Home'
  ? `${INFO.nome} — Laboratorio di panificazione a Torino, fornitura all’ingrosso`
  : `${title} · ${INFO.nome}, laboratorio di panificazione a Torino`;
const NAV = [['prodotti/', 'Prodotti'], ['laboratorio/', 'Il laboratorio'], ['ingrosso/', 'Ingrosso'], ['contatti/', 'Contatti']];
const MAIL = `mailto:${INFO.email}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Bakery',
  name: INFO.nome,
  legalName: INFO.societa,
  email: INFO.email,
  telephone: INFO.telHref,
  address: { '@type': 'PostalAddress', addressLocality: INFO.citta, addressRegion: 'TO', addressCountry: 'IT' },
  areaServed: 'Torino',
  url: 'https://www.moledigitale.it/demoPuntoPane/',
  image: 'https://www.moledigitale.it/img/puntopane/anteprima.jpg',
  sameAs: [INFO.instagram],
};
---
<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{pieno}</title>
  <meta name="description" content={desc} />
  <meta name="theme-color" content="#f6f1e7" />
  <link rel="preload" as="font" type="font/woff2" href={jostWoff2} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={jakartaWoff2} crossorigin />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%23f6f1e7'/><circle cx='16' cy='16' r='10' fill='%239a4a1c'/></svg>" />
  <meta property="og:title" content={pieno} />
  <meta property="og:description" content={desc} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="it_IT" />
  <meta property="og:image" content="https://www.moledigitale.it/img/puntopane/anteprima.jpg" />
  <meta property="og:image:width" content="1024" />
  <meta property="og:image:height" content="538" />
  <meta property="og:image:alt" content="Pagnotte appena sfornate sugli scaffali di legno del laboratorio" />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  {/* prima di disegnare: con JavaScript acceso le sezioni entrano in scena, senza restano ferme e visibili */}
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
  <a class="salta" href="#main">Salta al contenuto</a>
  <aside aria-label="Anteprima di Mole Digitale"><a class="demo-flag" href="/">Anteprima realizzata da <b>Mole Digitale</b><span class="flag-piu"> — bozza di proposta per {INFO.nome}</span></a></aside>

  <header class="testata" id="testata">
    <div class="testata-in">
      <a href={BASE} class="marchio" aria-label={INFO.nome + ', pagina iniziale'}>
        <span class="marchio-punto" aria-hidden="true"></span>
        <span class="marchio-nome">Punto<b>Pane</b></span>
      </a>
      <nav class="menu" id="menu" aria-label="Menu principale">
        {NAV.map(([href, label]) => (
          <a href={BASE + href} class={active === label ? 'on' : undefined} aria-current={active === label ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
      <div class="testata-dx">
        <a href={BASE + 'contatti/#richiesta'} class="btn btn-crosta testata-cta">Richiedi il listino</a>
        <button class="menu-btn" id="menuBtn" aria-label="Apri il menu" aria-expanded="false" aria-controls="menu"><span></span><span></span><span></span></button>
      </div>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <slot />
  </main>

  <footer class="piede">
    <div class="piede-in">
      <div class="piede-marca">
        <p class="piede-nome"><span class="marchio-punto" aria-hidden="true"></span><span>Punto<b>Pane</b></span></p>
        <p class="piede-claim">Laboratorio di panificazione a {INFO.citta}. Pane a lievito madre per chi lo serve ai propri clienti.</p>
      </div>
      <div>
        <h2>Prodotti</h2>
        <ul>
          {CATEGORIE.map((c) => <li><a href={`${BASE}prodotti/?cat=${c.id}`}>{c.t}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>L’azienda</h2>
        <ul>
          <li><a href={BASE + 'laboratorio/'}>Il laboratorio</a></li>
          <li><a href={BASE + 'ingrosso/'}>Fornitura all’ingrosso</a></li>
          <li><a href={BASE + 'contatti/#richiesta'}>Richiedi il listino</a></li>
        </ul>
      </div>
      <div>
        <h2>Contatti</h2>
        <ul>
          <li><a href={MAIL}>{INFO.email}</a></li>
          <li><a href={'tel:' + INFO.telHref}>{INFO.tel}</a></li>
          <li><a href={INFO.instagram} target="_blank" rel="noopener">Instagram</a></li>
        </ul>
      </div>
    </div>
    <p class="piede-legale">
      <span>{INFO.nome} · {INFO.societa} · {INFO.citta}</span>
      <span><a href={BASE + 'privacy/'}>Privacy e crediti foto</a></span>
      <span>Bozza dimostrativa · <a href="/">Mole Digitale</a></span>
    </p>
  </footer>

  <!-- da telefono: le tre azioni che contano, sempre sotto il pollice -->
  <nav class="barra-mobile" aria-label="Azioni rapide">
    <a href={'tel:' + INFO.telHref}>Chiama</a>
    <a href={MAIL}>Email</a>
    <a href={BASE + 'contatti/#richiesta'} class="barra-cta">Richiedi il listino</a>
  </nav>

  <style is:global>
    :root{
      --farina:#f6f1e7; --carta:#fffcf6; --kraft:#ecdcc0; --kraft-2:#d9bf94;
      --crosta:#9a4a1c; --crosta-scura:#773612; --grano:#e2b35e;
      --inchiostro:#2a1e16; --testo:#43352b; --muto:#6b5b4e; --filo:#e3d6c0;
      --disp:'Jost Variable',system-ui,sans-serif; --sans:'Plus Jakarta Sans Variable',system-ui,sans-serif;
      --e:cubic-bezier(.2,.7,.2,1); --testata:76px; --flag:28px;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    [hidden]{display:none !important}
    html{scroll-behavior:smooth;scroll-padding-top:calc(var(--flag) + var(--testata) + 24px)}
    @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none !important;animation:none !important}}
    body{background:var(--farina);color:var(--testo);font-family:var(--sans);font-size:1rem;line-height:1.65;-webkit-font-smoothing:antialiased}
    img{display:block;max-width:100%;height:auto}
    a{color:inherit;text-decoration:none}
    ul{list-style:none}
    h1,h2,h3,h4{font-family:var(--disp);font-weight:600;color:var(--inchiostro);line-height:1.08;letter-spacing:-.015em;text-wrap:balance}
    a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:2px solid var(--crosta);outline-offset:3px}
    .salta{position:absolute;left:-999px;top:0;background:var(--inchiostro);color:#fff;padding:.6rem 1rem;z-index:999}
    .salta:focus{left:8px;top:8px}
    .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

    .demo-flag{position:fixed;top:0;left:0;right:0;z-index:300;height:var(--flag);display:flex;align-items:center;justify-content:center;background:var(--inchiostro);color:#e8dcc8;font-size:.75rem;letter-spacing:.02em}
    .demo-flag b{color:#fff;margin:0 .25em}
    @media (max-width:640px){.flag-piu{display:none}}

    /* testata */
    /* fondo pieno: semitrasparente, sopra le fasce scure diventava grigio */
    .testata{position:fixed;top:var(--flag);left:0;right:0;z-index:200;background:var(--farina);border-bottom:1px solid transparent;transition:border-color .3s}
    .testata.giu{border-color:var(--filo)}
    .testata-in{max-width:1240px;height:var(--testata);margin:0 auto;display:flex;align-items:center;gap:2rem;padding:0 clamp(1rem,4vw,2.4rem)}
    .marchio{display:flex;align-items:center;gap:.55rem;font-family:var(--disp);font-size:1.6rem;line-height:1;color:var(--inchiostro);letter-spacing:-.02em}
    .marchio-nome{font-weight:400}
    .marchio-nome b,.piede-nome b{font-weight:700;color:var(--crosta)}
    .marchio-punto{width:.62em;height:.62em;border-radius:50%;background:var(--crosta);flex:none;box-shadow:inset 0 -3px 0 rgba(0,0,0,.18)}
    .menu{display:flex;gap:clamp(1.2rem,2.6vw,2.2rem);margin-left:auto}
    .menu a{font-family:var(--disp);font-weight:500;font-size:1.02rem;color:var(--testo);padding:.35rem 0;border-bottom:2px solid transparent;transition:color .2s,border-color .2s}
    .menu a:hover{color:var(--crosta)}
    .menu a.on{color:var(--crosta);border-color:var(--crosta)}
    .testata-dx{display:flex;align-items:center;gap:.8rem}
    .menu-btn{display:none;width:44px;height:44px;background:none;border:0;cursor:pointer;flex-direction:column;justify-content:center;align-items:center;gap:5px}
    .menu-btn span{display:block;width:22px;height:2px;background:var(--inchiostro);transition:transform .3s var(--e),opacity .2s}
    .menu-btn[aria-expanded="true"] span:nth-child(1){transform:translateY(7px) rotate(45deg)}
    .menu-btn[aria-expanded="true"] span:nth-child(2){opacity:0}
    .menu-btn[aria-expanded="true"] span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

    /* bottoni: angoli appena smussati, come un'etichetta */
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:48px;padding:.75rem 1.35rem;border-radius:10px;border:2px solid transparent;font-family:var(--disp);font-weight:600;font-size:1rem;letter-spacing:.01em;cursor:pointer;transition:background .2s,color .2s,border-color .2s,transform .2s var(--e);text-align:center}
    .btn:active{transform:scale(.98)}
    .btn-crosta{background:var(--crosta);color:#fff}
    .btn-crosta:hover{background:var(--crosta-scura)}
    .btn-bordo{border-color:var(--inchiostro);color:var(--inchiostro);background:transparent}
    .btn-bordo:hover{background:var(--inchiostro);color:var(--farina)}
    .btn-chiaro{background:var(--farina);color:var(--inchiostro)}
    .btn-chiaro:hover{background:var(--grano)}
    .btn svg{flex:none}

    /* impaginazione */
    .primo{padding-top:calc(var(--flag) + var(--testata) + clamp(2rem,5vw,3.5rem))}
    .misura{max-width:1240px;margin:0 auto;padding:0 clamp(1.1rem,4vw,2.4rem)}
    .stretta{max-width:820px}
    .banda{padding:clamp(3.5rem,8vw,6.5rem) 0}
    .occhiello{display:inline-flex;align-items:center;gap:.55rem;font-family:var(--disp);font-size:.8rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--crosta)}
    .occhiello::before{content:'';width:.55rem;height:.55rem;border-radius:50%;background:currentColor}
    .sez-h2{font-size:clamp(2rem,4.4vw,3.2rem);margin-top:.8rem}
    .sez-p{color:var(--muto);max-width:58ch;margin-top:1rem;font-size:1.06rem}
    .kraft{background:var(--kraft)}
    .scuro{background:var(--inchiostro);color:#e8dcc8}
    .scuro h2,.scuro h3{color:var(--farina)}
    .scuro .occhiello{color:var(--grano)}
    .scuro .sez-p{color:#cbbba6}

    /* note per il cliente: si vedono solo nella bozza */
    .promemoria{max-width:860px;margin:3rem auto 0;padding:1.1rem 1.3rem;border:1.5px dashed var(--kraft-2);border-radius:12px;background:rgba(236,220,192,.35);color:var(--muto);font-size:.9rem;line-height:1.6}
    .promemoria b{color:var(--inchiostro)}
    .promemoria ul{margin:.4rem 0 0 1.1rem;list-style:disc}

    /* foto con l'angolo smussato e un filo di carta */
    .foto{border-radius:14px;overflow:hidden;background:var(--kraft)}
    .foto img{width:100%;height:100%;object-fit:cover}

    /* moduli */
    .modulo{display:grid;gap:1.1rem}
    .modulo label,.modulo legend{display:grid;gap:.4rem;font-size:.88rem;font-weight:700;color:var(--inchiostro)}
    .modulo small{font-weight:500;font-size:.82rem;color:var(--muto)}
    .modulo input,.modulo select,.modulo textarea{width:100%;min-width:0;padding:.8rem .9rem;border:1.5px solid var(--filo);border-radius:10px;background:var(--carta);font:inherit;font-weight:500;font-size:1rem;color:var(--inchiostro)}
    .modulo input:focus,.modulo select:focus,.modulo textarea:focus{outline:0;border-color:var(--crosta);box-shadow:0 0 0 3px rgba(154,74,28,.15)}
    .modulo [aria-invalid="true"]{border-color:#a52a1a;background:#fff6f3}
    .errore{color:#9b2414;font-size:.86rem;font-weight:600}

    /* entrata delle sezioni: solo con JavaScript acceso e se il visitatore non ha chiesto meno movimento */
    @media (prefers-reduced-motion:no-preference){
      .js .rv{opacity:0;transform:translateY(18px);transition:opacity .7s var(--e),transform .7s var(--e)}
      .js .rv.vista{opacity:1;transform:none}
    }

    /* piede */
    .piede{background:var(--inchiostro);color:#cdbfaa}
    .piede-in{max-width:1240px;margin:0 auto;padding:clamp(3rem,6vw,4.5rem) clamp(1.1rem,4vw,2.4rem) 2rem;display:grid;grid-template-columns:1.5fr 1fr 1fr 1.2fr;gap:2.5rem}
    .piede h2{font-family:var(--disp);font-size:.8rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--grano);margin-bottom:.9rem}
    .piede li{margin-bottom:.45rem}
    .piede a{transition:color .2s}
    .piede a:hover{color:#fff}
    .piede-nome{display:flex;align-items:center;gap:.5rem;font-family:var(--disp);font-size:1.9rem;line-height:1;color:var(--farina)}
    .piede-nome b{color:var(--grano)}
    .piede-nome .marchio-punto{background:var(--grano)}
    .piede-claim{margin-top:.9rem;max-width:34ch;color:#b8a892}
    .piede-legale{max-width:1240px;margin:0 auto;padding:1.2rem clamp(1.1rem,4vw,2.4rem) 2rem;border-top:1px solid rgba(255,255,255,.1);display:flex;flex-wrap:wrap;gap:.6rem 2rem;font-size:.8rem;color:#a39380}
    .piede-legale a{text-decoration:underline;text-underline-offset:3px}

    .barra-mobile{display:none}

    @media (max-width:980px){
      .menu{position:fixed;top:calc(var(--flag) + var(--testata));left:0;right:0;flex-direction:column;align-items:center;gap:1.3rem;padding:1.8rem 1rem 2.2rem;background:var(--farina);border-bottom:1px solid var(--filo);margin:0;display:none}
      .testata.aperta .menu{display:flex}
      .menu a{font-size:1.2rem}
      .testata-dx{margin-left:auto}
      .menu-btn{display:flex}
      .piede-in{grid-template-columns:1fr 1fr;gap:2rem}
      .piede-marca{grid-column:1/-1}
    }
    @media (max-width:640px){
      :root{--testata:64px}
      .marchio{font-size:1.4rem}
      .testata-cta{display:none}
      .piede-in{grid-template-columns:1fr}
      .barra-mobile{display:grid;grid-template-columns:auto auto 1fr;gap:.4rem;position:fixed;left:0;right:0;bottom:0;z-index:160;background:var(--carta);border-top:1px solid var(--filo);padding:.6rem .8rem calc(.6rem + env(safe-area-inset-bottom))}
      .barra-mobile a{display:flex;align-items:center;justify-content:center;min-height:48px;padding:0 .9rem;border-radius:10px;font-family:var(--disp);font-weight:600;white-space:nowrap;color:var(--inchiostro)}
      .barra-cta{background:var(--crosta);color:#fff !important}
      body{padding-bottom:76px}
      /* quello che riceve il fuoco (o viene portato in vista) non finisce sotto la barra in basso */
      html{scroll-padding-bottom:96px}
    }
  </style>

  <script>
    const t = document.getElementById('testata');
    const b = document.getElementById('menuBtn');
    const menu = (aperto) => {
      t.classList.toggle('aperta', aperto);
      b.setAttribute('aria-expanded', String(aperto));
      b.setAttribute('aria-label', aperto ? 'Chiudi il menu' : 'Apri il menu');
    };
    b.addEventListener('click', () => menu(!t.classList.contains('aperta')));
    document.querySelectorAll('#menu a').forEach((a) => a.addEventListener('click', () => menu(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && t.classList.contains('aperta')) { menu(false); b.focus(); }
    });
    // filo sotto la testata appena si scende
    const giu = () => t.classList.toggle('giu', scrollY > 8);
    addEventListener('scroll', giu, { passive: true }); giu();
    // entrata delle sezioni
    const rv = document.querySelectorAll('.rv');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('vista'); io.unobserve(e.target); } }), { threshold: 0.12 });
      rv.forEach((el) => io.observe(el));
    } else rv.forEach((el) => el.classList.add('vista'));
  </script>
</body>
</html>
