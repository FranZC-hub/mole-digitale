---
import Layout from '../../layouts/Layout.astro';
import { CLIENTI } from '../../data/clienti.js';

// PAGINA PRIVATA — le versioni REALI dei siti clienti, in sviluppo: database, area riservata
// con password vera, messaggi via email. Ogni progetto nasce come bozza in /demoClienti/;
// quando il cliente dice si', la versione reale cresce qui prima di andare sul suo dominio.
// Come /demoClienti: non collegata dal sito, noindex, fuori dalla sitemap (astro.config.mjs).
// Elenca TUTTI i clienti: chi non ha ancora la versione reale compare con la sola bozza.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

// Credenziali dell'area riservata: mai nel codice (il repository e' pubblico). Si leggono qui,
// durante la build: dai secret di GitHub (es. MAS_DEV_PASSWORD) per il sito online, oppure in
// locale dal database d'esempio creato da `npm run mas:esempio`.
function credenziali(a) {
  const pass = process.env[a.env + '_PASSWORD'];
  if (pass) return { user: process.env[a.env + '_UTENTE'] || 'negozio', pass, nota: '' };
  try {
    const j = JSON.parse(readFileSync(join(process.cwd(), a.locale), 'utf8'));
    return { user: j.utente, pass: j.password, nota: 'database d’esempio in locale' };
  } catch {
    return null;
  }
}

// Checklist: le voci ✅/⬜ di docs/<cliente>/PRODUZIONE.md, sezione per sezione (le righe
// rientrate continuano la voce sopra). Il documento resta l'unica fonte: niente doppioni.
const html = (t) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
  .replace(/`([^`]+)`/g, '<code>$1</code>').replace(/\*\*([^*]+)\*\*/g, '<b>$1</b>');
function checklist(file) {
  const sezioni = [];
  let sez = null, voce = null;
  for (const riga of readFileSync(join(process.cwd(), file), 'utf8').replace(/\r\n/g, '\n').split('\n')) {
    const h = riga.match(/^## (.+)/);
    if (h) {
      const [titolo, chi] = h[1].split(/ — (?=[^—]*$)/);
      sez = { titolo: /noi|negozio/.test(chi || '') ? titolo : h[1], chi: /negozio/.test(chi || '') ? 'Dal negozio' : /noi/.test(chi || '') ? 'Noi' : '', voci: [] };
      sezioni.push(sez); voce = null; continue;
    }
    const v = riga.match(/^- (✅|⬜) (.*)/);
    if (v && sez) { voce = { fatto: v[1] === '✅', testo: v[2] }; sez.voci.push(voce); continue; }
    if (voce && /^ {2,}\S/.test(riga)) { voce.testo += ' ' + riga.trim(); continue; }
    voce = null;
  }
  return sezioni.filter((s) => s.voci.length).map((s) => ({
    ...s,
    voci: s.voci.map((x) => ({ ...x, html: html(x.testo) })),
    daFare: s.voci.filter((x) => !x.fatto).length,
  }));
}

const reali = CLIENTI.filter((c) => c.dev).map((c) => {
  const lista = c.dev.checklist ? checklist(c.dev.checklist) : [];
  return {
    ...c,
    cred: credenziali(c.dev.accesso),
    daFare: lista.filter((s) => s.daFare > 0),
    fatte: lista.filter((s) => s.daFare === 0),
    contaDaFare: lista.reduce((n, s) => n + s.daFare, 0),
    contaFatte: lista.reduce((n, s) => n + s.voci.length - s.daFare, 0),
  };
});
const soloBozza = CLIENTI.filter((c) => !c.dev);
---
<Layout
  title="Versioni reali dei clienti — pagina privata | Mole Digitale"
  description="Pagina privata: i siti dei clienti in sviluppo, con database e area riservata."
  noindex={true}
>
  <section class="section" style="padding-top:8rem;">
    <div class="section-head" data-reveal>
      <span class="kicker">Riservato · sviluppo</span>
      <h1>I siti dei clienti, <span class="grad">quelli veri</span>.</h1>
      <p class="section-lead">Qui i siti funzionano davvero: database, area riservata con password, messaggi che arrivano per email. Ogni progetto parte come bozza in <a class="in-testo" href="/demoClienti/">/demoClienti</a>; quando il cliente dice sì, cresce qui prima di andare sul suo dominio.</p>
    </div>

    <div class="avviso glass" data-reveal>
      <b>Questa pagina è privata, e qui i dati sono veri.</b>
      <p>Non è collegata dal sito, non è nella sitemap ed è marcata <code>noindex</code>, come anche le versioni qui sotto. Ma qui ci sono le <b>password delle aree riservate vere</b>: chi ha questo link entra, e vede anche i messaggi lasciati dai clienti. Non mandarla a nessuno: a un cliente manda il link del suo sito. Le password non sono nel codice (il repository è pubblico): la pagina le prende dal server quando viene pubblicata.</p>
    </div>

    <div class="clienti">
      {reali.map((c) => (
        <article class="cliente glass" data-reveal>
          <header class="cl-testa">
            <div>
              <span class="cl-stato cl-stato-dev">{c.dev.stato}</span>
              <h2>{c.nome}</h2>
              <p class="cl-meta">{c.settore} · {c.dove}</p>
              <p class="cl-tecnica">{c.dev.tecnica}</p>
            </div>
            <a href={c.dev.url} class="btn btn-primary cl-apri">Apri il sito →</a>
          </header>

          <h3 class="cl-h3">Cosa c’è in più rispetto alla bozza</h3>
          <ul class="cl-dentro">
            {c.dev.dentro.map((d) => <li>{d}</li>)}
          </ul>

          <h3 class="cl-h3">Le pagine</h3>
          <nav class="cl-pagine" aria-label={'Pagine del sito ' + c.nome}>
            {c.dev.pagine.map((p) => <a href={p.u}>{p.t}</a>)}
          </nav>

          {c.daFare.length + c.fatte.length > 0 && (
            <section class="cl-check" aria-label={'Cosa manca per ' + c.nome}>
              <h3 class="cl-h3">Cosa manca <span class="cl-conta">{c.contaDaFare} da fare · {c.contaFatte} fatte</span></h3>
              {c.daFare.map((s) => (
                <div class="ck-sez">
                  <p class="ck-titolo">{s.titolo}{s.chi && <span class="ck-chi">{s.chi}</span>}</p>
                  <ul class="ck-lista">
                    {s.voci.map((x) => (
                      <li class={x.fatto ? 'ck-fatto' : undefined}>
                        <span class="ck-box" aria-hidden="true">{x.fatto ? '✓' : ''}</span>
                        <span class="sr-only">{x.fatto ? 'Fatto: ' : 'Da fare: '}</span>
                        <span set:html={x.html} />
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
              {c.fatte.map((s) => (
                <details class="ck-sez ck-chiusa">
                  <summary class="ck-titolo">{s.titolo} <span class="ck-chi">{s.voci.length} fatte</span></summary>
                  <ul class="ck-lista">
                    {s.voci.map((x) => (
                      <li class="ck-fatto"><span class="ck-box" aria-hidden="true">✓</span><span set:html={x.html} /></li>
                    ))}
                  </ul>
                </details>
              ))}
              <p class="ck-fonte">Dalla checklist <code>{c.dev.checklist}</code>: per spuntare una voce, nel documento ⬜ diventa ✅.</p>
            </section>
          )}

          <div class="cl-accesso">
            <div>
              <span class="cl-acc-et">{c.dev.accesso.t}</span>
              {c.cred ? (
                <p class="cl-acc-cred">utente <code>{c.cred.user}</code> · password <code>{c.cred.pass}</code>{c.cred.nota && <span class="cl-acc-nota"> ({c.cred.nota})</span>}</p>
              ) : (
                <p class="cl-acc-cred">Credenziali non ancora impostate: si creano all’installazione sul server (secret <code>{c.dev.accesso.env}_PASSWORD</code> per mostrarle qui)</p>
              )}
            </div>
            <div class="cl-azioni">
              <a href={c.url} class="btn btn-ghost">La bozza</a>
              <a href={c.dev.accesso.u} class="btn btn-ghost">Apri →</a>
            </div>
          </div>
        </article>
      ))}
    </div>

    {soloBozza.length > 0 && (
      <div class="attesa" data-reveal>
        <h2 class="attesa-titolo">Ancora solo bozza</h2>
        <p class="attesa-lead">Per questi clienti la versione reale non è ancora iniziata: c’è la bozza da far vedere.</p>
        <ul class="attesa-lista">
          {soloBozza.map((c) => (
            <li class="glass">
              <div>
                <span class="attesa-nome">{c.nome}</span>
                <span class="attesa-meta">{c.settore} · {c.dove}</span>
              </div>
              <a href={c.url} class="btn btn-ghost">Apri la bozza →</a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <p class="chiusa" data-reveal>
      Le bozze per i clienti stanno in <a href="/demoClienti/">/demoClienti</a>, le demo generiche di settore in <a href="/demo/">/demo</a>.
    </p>
  </section>

  <style>
    .in-testo{color:var(--c2);border-bottom:1px solid rgba(34,211,238,.4)}
    .avviso{max-width:820px;margin:0 auto 3rem;padding:1.6rem 1.8rem;border-radius:var(--radius);
      border-left:3px solid var(--warning)}
    .avviso b{color:var(--text)}
    .avviso p{color:var(--muted);font-size:.95rem;margin-top:.4rem}
    .avviso code{background:rgba(255,255,255,.08);border-radius:6px;padding:.1rem .4rem;font-size:.88em}

    .clienti{display:grid;gap:1.6rem;max-width:900px;margin:0 auto}
    .cliente{padding:clamp(1.6rem,3vw,2.4rem);border-radius:var(--radius)}
    .cl-testa{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:start;gap:1.5rem}
    .cl-stato{display:inline-block;font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;font-weight:700;
      border-radius:999px;padding:.2rem .7rem;margin-bottom:.7rem}
    .cl-stato-dev{color:var(--c2);border:1px solid rgba(34,211,238,.4)}
    .cl-testa h2{font-size:clamp(1.5rem,3vw,2rem);line-height:1.15}
    .cl-meta{color:var(--muted-2);font-size:.9rem;margin-top:.3rem}
    .cl-tecnica{color:var(--muted);font-size:.86rem;margin-top:.5rem}
    .cl-apri{flex:none}

    .cl-h3{font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:var(--muted-2);font-weight:700;margin:1.8rem 0 .7rem}
    .cl-dentro{list-style:none;display:grid;gap:.5rem}
    .cl-dentro li{color:var(--muted);font-size:.94rem;padding-left:1.4rem;position:relative}
    .cl-dentro li::before{content:'';position:absolute;left:0;top:.55em;width:6px;height:6px;border-radius:50%;background:var(--c2)}

    .cl-pagine{display:flex;flex-wrap:wrap;gap:.5rem}
    .cl-pagine a{border:1px solid var(--border);border-radius:999px;padding:.35rem .9rem;font-size:.86rem;
      color:var(--muted);transition:.25s var(--ease)}
    .cl-pagine a:hover{border-color:rgba(34,211,238,.55);color:var(--text);transform:translateY(-1px)}

    /* checklist: le voci di docs/<cliente>/PRODUZIONE.md */
    .cl-conta{margin-left:.6rem;letter-spacing:.08em;color:var(--warning)}
    .ck-sez{margin-top:1.1rem}
    .ck-titolo{font-weight:700;color:var(--text);font-size:.95rem;display:flex;align-items:center;gap:.6rem;flex-wrap:wrap}
    .ck-chi{font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;font-weight:700;color:var(--muted-2);
      border:1px solid var(--border);border-radius:999px;padding:.12rem .55rem}
    .ck-lista{list-style:none;display:grid;gap:.55rem;margin-top:.7rem}
    .ck-lista li{display:grid;grid-template-columns:1.15rem minmax(0,1fr);gap:.7rem;align-items:start;
      color:var(--muted);font-size:.92rem;line-height:1.55}
    .ck-box{width:1.15rem;height:1.15rem;margin-top:.12rem;border:1.5px solid rgba(255,200,61,.6);border-radius:5px;
      display:grid;place-items:center;font-size:.75rem;font-weight:800;line-height:1}
    .ck-fatto .ck-box{border-color:rgba(34,211,238,.6);background:rgba(34,211,238,.14);color:var(--c2)}
    .ck-fatto{opacity:.75}
    .ck-lista code{background:rgba(255,255,255,.08);border-radius:5px;padding:.05rem .35rem;font-size:.86em;overflow-wrap:anywhere}
    .ck-lista b{color:var(--text)}
    .ck-chiusa summary{cursor:pointer;list-style:none}
    .ck-chiusa summary::-webkit-details-marker{display:none}
    .ck-chiusa summary::before{content:'▸';color:var(--c2);transition:transform .2s var(--ease)}
    .ck-chiusa[open] summary::before{transform:rotate(90deg)}
    .ck-fonte{margin-top:1.1rem;color:var(--muted-2);font-size:.82rem}
    .ck-fonte code{background:rgba(255,255,255,.08);border-radius:5px;padding:.05rem .35rem}
    .cl-acc-cred code{background:rgba(255,255,255,.08);border-radius:6px;padding:.12rem .45rem;color:var(--text)}
    .cl-acc-nota{color:var(--muted-2);font-size:.85rem}

    .cl-accesso{display:flex;align-items:center;justify-content:space-between;gap:1.2rem;flex-wrap:wrap;
      margin-top:1.8rem;padding-top:1.4rem;border-top:1px solid var(--border)}
    .cl-acc-et{font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted-2);font-weight:700}
    .cl-acc-cred{color:var(--muted);font-size:.92rem;margin-top:.25rem}
    .cl-azioni{display:flex;gap:.6rem;flex-wrap:wrap}

    .attesa{max-width:900px;margin:3.2rem auto 0}
    .attesa-titolo{font-size:clamp(1.2rem,2.4vw,1.5rem)}
    .attesa-lead{color:var(--muted);font-size:.94rem;margin-top:.4rem}
    .attesa-lista{list-style:none;display:grid;gap:.8rem;margin-top:1.2rem}
    .attesa-lista li{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;
      padding:1.1rem 1.4rem;border-radius:var(--radius)}
    .attesa-nome{display:block;font-weight:700;color:var(--text)}
    .attesa-meta{display:block;color:var(--muted-2);font-size:.88rem;margin-top:.15rem}

    .chiusa{text-align:center;color:var(--muted-2);font-size:.9rem;margin-top:2.6rem}
    .chiusa a{color:var(--c2);border-bottom:1px solid rgba(34,211,238,.4)}

    @media (max-width:640px){
      .cl-testa{grid-template-columns:1fr}
      .cl-apri{width:100%;justify-content:center}
    }
  </style>
</Layout>
