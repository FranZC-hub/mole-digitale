---
import Layout from './_Layout.astro';
import { INFO, PEZZI, orariSettimana, prezzoLabel } from './_shared.js';
const ORARI = orariSettimana();       // render statico: visibile anche senza JavaScript
const inVetrina = PEZZI.slice(0, 4);
const WA = `https://wa.me/${INFO.wa}`;
const servizi = [
  { ic: '💍', t: 'Gioielleria', d: 'Oro, argento e pietre preziose scelti uno a uno. Classici che durano e pezzi che non si vedono altrove.', href: 'vetrina/' },
  { ic: '⌚', t: 'Orologeria', d: 'Vendita, revisione e restauro. Dal solo tempo al cronografo, fino alla pendoleria d\'epoca.', href: 'vetrina/?cat=Orologi' },
  { ic: '🔨', t: 'Laboratorio', d: 'Creazioni su misura, trasformazioni e riparazioni: qui il gioiello nasce e rinasce, a pochi passi dal banco.', href: 'laboratorio/' },
  { ic: '📜', t: 'Perizie', d: 'Valutazioni per successioni, divisioni ereditarie e cassette di sicurezza. Con la massima discrezione.', href: 'perizie/' },
];
---
<Layout title="Preziosi di qualità dal 1996" active="Home">
  <!-- HERO -->
  <section class="hero">
    <div class="hero-text r">
      <span class="mkick">Gioielleria · Torino · dal {INFO.fondata}</span>
      <h1>Un gioiello non si compra.<br/><span class="oro it">Si sceglie.</span></h1>
      <p>Dal {INFO.fondata} in Corso Trapani lavoriamo l'oro come si faceva una volta: a mano, un pezzo alla volta. Vendiamo, creiamo, ripariamo e valutiamo — sempre guardandoci negli occhi.</p>
      <div class="hero-cta">
        <a href="/demoMasGioielli/vetrina/" class="mbtn mbtn-oro mbtn-lg">Guarda la vetrina</a>
        <a href={WA} target="_blank" rel="noopener" class="mbtn mbtn-ghost mbtn-lg">💬 Scrivici su WhatsApp</a>
      </div>
      <ul class="hero-trust">
        <li><b>★ {INFO.stelle}</b> su Google · {INFO.recensioni} recensioni</li>
        <li>Laboratorio interno</li>
        <li>Perizie e valutazioni</li>
      </ul>
    </div>

    <aside class="hero-panel r">
      <img src="/img/demo-gioielleria/hero.webp" width="660" height="660" alt="Anello solitario con diamante ovale, lavorazione MasGioielli" fetchpriority="high" />
      <div class="hero-ora">
        <p class="mstato" id="stato"><span class="punto"></span><b id="statoTxt">Orari del negozio</b></p>
        <p class="hero-ind">{INFO.via} — {INFO.citta}</p>
      </div>
    </aside>
  </section>

  <!-- SERVIZI -->
  <section class="msection">
    <div class="mhead mhead-c r">
      <span class="mkick">Cosa facciamo</span>
      <h2>Quattro mestieri, <span class="oro it">un solo banco</span></h2>
      <p>Non siamo solo un negozio: siamo anche il laboratorio dove il gioiello viene creato, aggiustato e valutato.</p>
    </div>
    <h3 class="sr-only">Elenco dei servizi</h3>
    <div class="serv-grid">
      {servizi.map((s) => (
        <a class="mcard serv r" href={'/demoMasGioielli/' + s.href}>
          <span class="mic" aria-hidden="true">{s.ic}</span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
          <span class="serv-go">Scopri →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- VETRINA IN EVIDENZA -->
  <section class="msection sec-vetrina">
    <div class="mhead mhead-c r">
      <span class="mkick">In vetrina</span>
      <h2>Qualche pezzo <span class="oro it">che ci piace</span></h2>
      <p>Una piccola selezione. In negozio ce n'è molti di più — e se non trovi quello giusto, lo creiamo.</p>
    </div>
    <h3 class="sr-only">Pezzi in evidenza</h3>
    <div class="vet-grid">
      {inVetrina.map((p) => (
        <a class="vet-card r" href={'/demoMasGioielli/vetrina/#' + p.id}>
          <div class="vet-img"><img src={p.img} width="640" height="480" alt={p.alt} loading="lazy" /></div>
          <div class="vet-body">
            <span class="vet-cat">{p.cat}</span>
            <h3>{p.nome}</h3>
            <p class="vet-mat">{p.materiale}</p>
            <b class="vet-prezzo">{prezzoLabel(p.prezzo)}</b>
          </div>
        </a>
      ))}
    </div>
    <p class="acenter r"><a href="/demoMasGioielli/vetrina/" class="mbtn mbtn-ghost">Vedi tutta la vetrina →</a></p>
  </section>

  <!-- LABORATORIO -->
  <section class="lab-band">
    <div class="lab-in">
      <div class="r">
        <span class="mkick">Il laboratorio</span>
        <h2>Quello che gli altri <span class="oro it">mandano via, noi lo facciamo qui.</span></h2>
        <p>Una maglia che si è rotta, un anello da stringere, un orologio del nonno fermo da anni. Il banco è dietro il negozio: vediamo il pezzo insieme e ti diciamo subito cosa si può fare e quanto costa.</p>
        <div class="lab-cta">
          <a href="/demoMasGioielli/laboratorio/" class="mbtn mbtn-oro">Chiedi un preventivo</a>
          <a href="/demoMasGioielli/perizie/" class="mbtn mbtn-ghost">Richiedi una perizia</a>
        </div>
      </div>
      <ul class="lab-list r">
        <li><b>Creazioni su misura</b><span>Dal disegno al pezzo finito, insieme a te.</span></li>
        <li><b>Riparazioni e trasformazioni</b><span>Saldature, misure, rimonta di pietre, restauro.</span></li>
        <li><b>Orologeria e pendoleria</b><span>Revisioni, pile, cinturini e orologi d'epoca.</span></li>
      </ul>
    </div>
  </section>

  <!-- RECENSIONI -->
  <section class="msection">
    <div class="mhead mhead-c r">
      <span class="mkick">Dicono di noi</span>
      <h2><span class="oro">★ {INFO.stelle}</span> su {INFO.recensioni} recensioni Google</h2>
    </div>
    <h3 class="sr-only">Recensioni dei clienti</h3>
    <div class="mgrid3">
      <blockquote class="mcard rev r"><div class="stelle" role="img" aria-label="Valutazione: 5 stelle su 5">★★★★★</div><p>«Mi hanno rimontato la pietra dell'anello di mia madre come fosse nuovo. Persone competenti e oneste.»</p><footer>Silvia R. · recensione Google</footer></blockquote>
      <blockquote class="mcard rev r"><div class="stelle" role="img" aria-label="Valutazione: 5 stelle su 5">★★★★★</div><p>«Perizia per la successione fatta con serietà e discrezione totale. Ci hanno spiegato tutto con calma.»</p><footer>Marco T. · recensione Google</footer></blockquote>
      <blockquote class="mcard rev r"><div class="stelle" role="img" aria-label="Valutazione: 5 stelle su 5">★★★★★</div><p>«Ho fatto fare le fedi su misura: seguiti passo passo, risultato bellissimo. Prezzo giusto.»</p><footer>Elena e Paolo · recensione Google</footer></blockquote>
    </div>
    <p class="md-hint r">💡 <b>Per il titolare:</b> qui compariranno le <b>vere recensioni Google</b> del negozio, aggiornate da sole: niente da copiare a mano.</p>
  </section>

  <!-- ORARI + INDIRIZZO -->
  <section class="msection sec-orari">
    <div class="orari-grid">
      <div class="r">
        <span class="mkick">Vieni a trovarci</span>
        <h2>{INFO.via}<br/><span class="oro it">{INFO.citta}</span></h2>
        <p class="orari-p">Siamo in zona San Paolo, con parcheggio in strada. Per le perizie e le creazioni su misura ti consigliamo di avvisarci: ti dedichiamo il tempo che serve.</p>
        <div class="orari-cta">
          <a href={'tel:' + INFO.telHref} class="mbtn mbtn-oro">📞 {INFO.tel}</a>
          <a href="/demoMasGioielli/contatti/" class="mbtn mbtn-ghost">Come arrivare</a>
        </div>
      </div>
      <div class="orari-card r">
        <p class="mstato" id="stato2"><span class="punto"></span><b id="statoTxt2">Orari del negozio</b></p>
        <ul class="morari" id="listaOrari">
          {ORARI.map((o) => <li class={o.i === 1 ? 'chiuso' : undefined}><span>{o.giorno}</span><b>{o.label}</b></li>)}
        </ul>
      </div>
    </div>
  </section>

  <style>
    .hero{max-width:1180px;margin:0 auto;padding:9rem clamp(1.2rem,5vw,3rem) 3rem;display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(2rem,5vw,4rem);align-items:center}
    .hero>*{min-width:0}
    .hero h1{font-size:clamp(2.8rem,6.4vw,5rem);margin:.6rem 0 1.2rem}
    .hero-text>p{color:var(--muted);font-size:1.1rem;max-width:52ch;margin-bottom:1.9rem}
    .hero-cta{display:flex;gap:.9rem;flex-wrap:wrap;margin-bottom:1.9rem}
    .hero-trust{list-style:none;display:flex;flex-direction:column;gap:.45rem;font-size:.92rem;color:var(--muted)}
    .hero-trust b{color:var(--oro-l)}
    .hero-panel{position:relative}
    .hero-panel img{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:2px;border:1px solid var(--linea)}
    .hero-ora{position:absolute;left:1.2rem;right:1.2rem;bottom:1.2rem;background:rgba(13,11,9,.9);backdrop-filter:blur(8px);border:1px solid var(--linea);border-radius:2px;padding:.9rem 1.1rem}
    .hero-ind{color:var(--muted);font-size:.86rem;margin-top:.25rem}

    .serv-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.1rem}
    .serv-grid>*{min-width:0}
    .serv{display:flex;flex-direction:column}
    .serv-go{margin-top:auto;padding-top:1rem;color:var(--oro-l);font-size:.86rem;font-weight:600}

    .sec-vetrina{padding-top:1rem}
    .vet-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.1rem}
    .vet-grid>*{min-width:0}
    .vet-card{background:var(--card);border:1px solid var(--linea);border-radius:3px;overflow:hidden;transition:transform .25s var(--e),border-color .25s}
    .vet-card:hover{transform:translateY(-5px);border-color:var(--oro-d)}
    .vet-img{overflow:hidden;background:var(--nero-2)}
    .vet-img img{width:100%;aspect-ratio:4/3;object-fit:cover;transition:transform .6s var(--e)}
    .vet-card:hover .vet-img img{transform:scale(1.05)}
    .vet-body{padding:1.1rem 1.2rem 1.3rem}
    .vet-cat{font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;color:var(--oro)}
    .vet-body h3{font-size:1.3rem;margin:.3rem 0 .2rem}
    .vet-mat{color:var(--muted-2);font-size:.82rem;margin-bottom:.6rem}
    .vet-prezzo{color:var(--oro-l);font-size:1.05rem}
    .acenter{text-align:center;margin-top:2rem}

    .lab-band{background:var(--nero-2);border-block:1px solid var(--linea)}
    .lab-in{max-width:1180px;margin:0 auto;padding:clamp(3rem,6vw,4.5rem) clamp(1.2rem,5vw,3rem);display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(2rem,5vw,3.5rem);align-items:center}
    .lab-in>*{min-width:0}
    .lab-in h2{font-size:clamp(1.9rem,4vw,2.9rem);margin:.5rem 0 1rem}
    .lab-in p{color:var(--muted);margin-bottom:1.6rem}
    .lab-cta{display:flex;gap:.9rem;flex-wrap:wrap}
    .lab-list{list-style:none;display:grid;gap:1rem}
    .lab-list li{border-left:2px solid var(--oro-d);padding-left:1.1rem}
    .lab-list b{display:block;font-family:var(--disp);font-size:1.3rem;color:var(--panna)}
    .lab-list span{color:var(--muted);font-size:.93rem}

    .rev{display:flex;flex-direction:column}
    .stelle{color:var(--oro);letter-spacing:3px;margin-bottom:.6rem}
    .rev p{flex:1;font-size:.98rem;color:var(--panna)}
    .rev footer{margin-top:.9rem;font-size:.84rem;color:var(--muted-2)}

    .sec-orari{padding-top:1rem}
    .orari-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(2rem,5vw,3.5rem);align-items:center}
    .orari-grid>*{min-width:0}
    .orari-grid h2{font-size:clamp(1.9rem,4vw,2.9rem);margin:.5rem 0 1rem}
    .orari-p{color:var(--muted);margin-bottom:1.6rem}
    .orari-cta{display:flex;gap:.9rem;flex-wrap:wrap}
    .orari-card{background:var(--card);border:1px solid var(--linea);border-radius:3px;padding:1.6rem}
    .orari-card .mstato{margin-bottom:1rem}

    @media (max-width:960px){
      .hero{grid-template-columns:1fr;padding-top:8rem}
      .serv-grid{grid-template-columns:1fr 1fr}
      .vet-grid{grid-template-columns:1fr 1fr}
      .lab-in,.orari-grid{grid-template-columns:1fr}
    }
    @media (max-width:560px){
      .serv-grid,.vet-grid{grid-template-columns:1fr}
    }
  </style>

  <script>
    import { renderOrari } from './_shared.js';
    renderOrari(document.getElementById('listaOrari'), document.getElementById('statoTxt2'));
    renderOrari(null, document.getElementById('statoTxt'));
  </script>
</Layout>
