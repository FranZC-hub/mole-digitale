---
import Layout from './_Layout.astro';
import { INFO, PEZZI, orariSettimana, prezzoLabel } from './_shared.js';
const ORARI = orariSettimana();          // reso lato server: leggibile anche senza JavaScript
const rail = PEZZI.slice(0, 6);
const WA = `https://wa.me/${INFO.wa}`;
const mestieri = [
  { n: '01', t: 'Gioielleria', d: 'Oro, argento e pietre scelti uno a uno. Il classico che dura e il pezzo che non si vede altrove.', href: 'vetrina/' },
  { n: '02', t: 'Orologeria', d: 'Vendita, revisione e restauro: dal solo tempo al cronografo, fino alla pendoleria d’epoca.', href: 'vetrina/?cat=Orologi' },
  { n: '03', t: 'Atelier', d: 'Creazioni su misura, trasformazioni e riparazioni. Il banco è dietro il negozio, non altrove.', href: 'laboratorio/' },
  { n: '04', t: 'Perizie', d: 'Valutazioni per successioni, divisioni ereditarie e cassette di sicurezza. Con discrezione.', href: 'perizie/' },
];
---
<Layout title="Preziosi di qualità dal 1996" active="Maison">

  <!-- APERTURA: tipografia grande a sinistra, fotografia a vivo a destra -->
  <section class="apertura">
    <div class="apertura-testo">
      <span class="occhiello">Torino · dal {INFO.fondata}</span>
      <h1>Un gioiello<br/>non si compra.<br/><span class="it oro">Si sceglie.</span></h1>
      <p>Dal {INFO.fondata}, in Corso Trapani, lavoriamo l’oro come si faceva una volta: a mano, un pezzo alla volta. Vendiamo, creiamo, ripariamo e valutiamo — sempre guardandoci negli occhi.</p>
      <div class="apertura-azioni">
        <a href="/demoMasGioielli/vetrina/" class="btn">Vedi la collezione</a>
        <a href={WA} target="_blank" rel="noopener" class="link-filo">Scrivici su WhatsApp</a>
      </div>
    </div>
    <div class="apertura-foto">
      <img src="/img/demo-gioielleria/p-solitario.webp" width="640" height="480"
           alt="Anello solitario con diamante ovale indossato al dito" fetchpriority="high" />
    </div>
  </section>

  <!-- RIGA DI FIDUCIA -->
  <section class="fiducia">
    <div class="misura fiducia-in">
      <p><b>★ {INFO.stelle}</b> su {INFO.recensioni} recensioni Google</p>
      <p>Laboratorio artigianale interno</p>
      <p>Perizie e valutazioni</p>
      <p class="fiducia-ora"><span class="stato" id="stato"><span class="pt"></span><span id="statoTxt">Orari del negozio</span></span></p>
    </div>
  </section>

  <!-- I MESTIERI: elenco editoriale numerato, niente riquadri -->
  <section class="banda">
    <div class="misura">
      <div class="intro a">
        <span class="occhiello">Cosa facciamo</span>
        <h2>Quattro mestieri,<br/>un solo banco.</h2>
      </div>
      <h3 class="sr-only">I nostri mestieri</h3>
      <ul class="mestieri">
        {mestieri.map((m) => (
          <li class="a">
            <a href={'/demoMasGioielli/' + m.href}>
              <span class="mest-n">{m.n}</span>
              <span class="mest-t">{m.t}</span>
              <span class="mest-d">{m.d}</span>
              <span class="mest-fr" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- COLLEZIONE: rail orizzontale, immagini con didascalia sotto -->
  <section class="banda collezione">
    <div class="misura">
      <div class="coll-testa a">
        <div class="intro">
          <span class="occhiello">La collezione</span>
          <h2>Qualche pezzo<br/>che ci piace.</h2>
        </div>
        <div class="coll-azioni">
          <span class="coll-scorri" aria-hidden="true">Scorri<span class="coll-fr">→</span></span>
          <a href="/demoMasGioielli/vetrina/" class="link-filo coll-tutti">Vedi tutto</a>
        </div>
      </div>
    </div>
    <h3 class="sr-only">Pezzi in evidenza</h3>
    <div class="rail" id="rail" tabindex="0" role="region" aria-label="Pezzi in evidenza, scorrevole orizzontalmente">
      {rail.map((p) => (
        <a class="rail-el" href={'/demoMasGioielli/vetrina/#' + p.id}>
          <div class="rail-foto"><img src={p.img} width="640" height="480" alt={p.alt} loading="lazy" /></div>
          <p class="rail-cat">{p.cat}</p>
          <p class="rail-nome">{p.nome}</p>
          <p class="rail-prezzo">{prezzoLabel(p.prezzo)}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- ATELIER: banda scura, citazione grande -->
  <section class="scuro atelier">
    <div class="misura atelier-in">
      <div class="a">
        <span class="occhiello">L’atelier</span>
        <blockquote class="atelier-q">
          «Quello che gli altri<br/>mandano via,<br/><span class="it atelier-oro">noi lo facciamo qui.»</span>
        </blockquote>
      </div>
      <div class="atelier-testo a">
        <p>Una maglia che si è spezzata, un anello da stringere, l’orologio del nonno fermo da vent’anni. Il banco è dietro il negozio: guardiamo il pezzo insieme e vi diciamo subito cosa si può fare, e quanto costa.</p>
        <ul class="atelier-lista">
          <li>Creazioni su misura, dal disegno al pezzo finito</li>
          <li>Riparazioni, saldature, misure e rimonta di pietre</li>
          <li>Orologeria e pendoleria, anche d’epoca</li>
        </ul>
        <div class="atelier-azioni">
          <a href="/demoMasGioielli/laboratorio/" class="btn btn-chiaro">Preventivo in 30 secondi</a>
          <a href="/demoMasGioielli/laboratorio/#misura" class="link-filo atelier-link">Che misura porti?</a>
        </div>
      </div>
    </div>
  </section>

  <!-- PERIZIE: molta aria, centrato -->
  <section class="banda perizie">
    <div class="misura stretta perizie-in a">
      <span class="occhiello centro">Perizie e valutazioni</span>
      <h2>Sapere quanto vale,<br/><span class="it oro">con discrezione.</span></h2>
      <p>Successioni, divisioni tra eredi, apertura di cassette di sicurezza. La prima stima verbale è sempre gratuita, e quello che ci portate resta tra noi.</p>
      <a href="/demoMasGioielli/perizie/" class="btn btn-vuoto">Richiedi una perizia</a>
    </div>
  </section>

  <!-- UNA SOLA VOCE -->
  <section class="banda voce">
    <div class="misura stretta a">
      <blockquote class="voce-q">
        <p>«Mi hanno rimontato la pietra dell’anello di mia madre come fosse nuovo. Persone competenti e oneste.»</p>
        <footer><span class="voce-st" role="img" aria-label="Valutazione: 5 stelle su 5">★★★★★</span> Silvia R. — recensione Google</footer>
      </blockquote>
      <p class="promemoria">💡 <b>Per il titolare:</b> qui comparirà una selezione delle <b>vere recensioni Google</b>, aggiornata da sola: niente da copiare a mano.</p>
    </div>
  </section>

  <!-- VISITA: indirizzo e orari, a filo -->
  <section class="banda visita">
    <div class="misura visita-in">
      <div class="a">
        <span class="occhiello">Vieni a trovarci</span>
        <h2>{INFO.via}<br/><span class="it oro">{INFO.citta}</span></h2>
        <p class="visita-p">Zona San Paolo, si parcheggia davanti. Per le perizie e le creazioni su misura vi consigliamo di avvisarci: vi dedichiamo il tempo che serve.</p>
        <div class="visita-azioni">
          <a href={'tel:' + INFO.telHref} class="btn">{INFO.tel}</a>
          <a href="/demoMasGioielli/contatti/" class="link-filo">Come arrivare</a>
        </div>
      </div>
      <div class="a">
        <h3 class="visita-h3">Orari di apertura</h3>
        <ul class="orari" id="listaOrari">
          {ORARI.map((o) => <li><span>{o.giorno}</span><b>{o.label}</b></li>)}
        </ul>
      </div>
    </div>
  </section>

  <style>
    /* ---------- apertura ---------- */
    .apertura{display:grid;grid-template-columns:1fr 42vw;align-items:center;gap:clamp(2rem,5vw,4rem);
      padding-top:calc(var(--tastata) + clamp(2.5rem,7vw,5.5rem));padding-bottom:clamp(3rem,7vw,5.5rem)}
    .apertura>*{min-width:0}
    .apertura-testo{padding-left:clamp(1.2rem,5vw,3.2rem);max-width:44rem;justify-self:end;width:100%}
    .apertura h1{font-size:clamp(2.9rem,7vw,5.6rem);margin:1.6rem 0 0}
    .apertura-testo>p{color:var(--grafite);font-size:1.05rem;max-width:46ch;margin-top:1.7rem}
    .apertura-azioni{display:flex;align-items:center;gap:2rem;flex-wrap:wrap;margin-top:2.4rem}
    .apertura-foto img{width:100%;height:clamp(380px,68vh,680px);object-fit:cover;object-position:center 42%}

    /* ---------- riga di fiducia ---------- */
    .fiducia{border-block:1px solid var(--filo)}
    .fiducia-in{display:flex;justify-content:space-between;align-items:center;gap:1.5rem;flex-wrap:wrap;padding-block:1.15rem;font-size:.82rem;letter-spacing:.04em;color:var(--grafite)}
    .fiducia-in b{color:var(--oro);font-weight:500}
    .fiducia-ora{margin-left:auto}

    /* ---------- mestieri ---------- */
    .mestieri{list-style:none;margin-top:clamp(2.5rem,5vw,4rem);border-top:1px solid var(--filo)}
    .mestieri a{display:grid;grid-template-columns:auto minmax(11rem,18%) 1fr auto;align-items:baseline;gap:clamp(1rem,3vw,2.5rem);
      padding:clamp(1.5rem,3vw,2.2rem) 0;border-bottom:1px solid var(--filo);transition:padding-left .4s var(--e)}
    .mestieri a:hover{padding-left:1rem}
    .mest-n{font-family:var(--disp);font-size:1rem;color:var(--oro)}
    .mest-t{font-family:var(--disp);font-size:clamp(1.7rem,3.2vw,2.5rem);line-height:1.1}
    .mest-d{color:var(--grafite);font-size:.96rem;max-width:52ch}
    .mest-fr{color:var(--oro);font-size:1.1rem;opacity:0;transition:opacity .3s var(--e)}
    .mestieri a:hover .mest-fr{opacity:1}

    /* ---------- collezione: rail orizzontale ---------- */
    .collezione{padding-bottom:clamp(3.5rem,7vw,6rem)}
    .coll-testa{display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;flex-wrap:wrap}
    .coll-tutti{white-space:nowrap}
    .rail{display:flex;gap:clamp(1rem,2.5vw,2rem);overflow-x:auto;scroll-snap-type:x mandatory;
      padding:clamp(2.2rem,4vw,3.2rem) clamp(1.2rem,5vw,3.2rem) .8rem;scrollbar-width:thin}
    .rail::-webkit-scrollbar{height:2px}
    .rail::-webkit-scrollbar-thumb{background:var(--filo)}
    .rail-el{flex:0 0 clamp(230px,26vw,330px);scroll-snap-align:start}
    .rail-foto{overflow:hidden;background:var(--avorio-2)}
    .rail-foto img{width:100%;aspect-ratio:4/5;object-fit:cover;transition:transform 1.1s var(--e)}
    .rail-el:hover .rail-foto img{transform:scale(1.04)}
    .rail-cat{font-size:.64rem;letter-spacing:.22em;text-transform:uppercase;color:var(--oro);margin-top:1.1rem}
    .rail-nome{font-family:var(--disp);font-size:1.5rem;line-height:1.2;margin-top:.3rem}
    .rail-prezzo{font-family:var(--disp);font-size:1.15rem;color:var(--oro);margin-top:.35rem;font-variant-numeric:lining-nums}
    .coll-azioni{display:flex;align-items:center;gap:2rem}
    .coll-scorri{display:inline-flex;align-items:center;gap:.5rem;font-size:.66rem;letter-spacing:.22em;text-transform:uppercase;color:var(--grigio)}
    .coll-fr{display:inline-block;animation:scorri 2.6s var(--e) infinite}
    @keyframes scorri{0%,100%{transform:translateX(0)}50%{transform:translateX(5px)}}
    @media (prefers-reduced-motion:reduce){.coll-fr{animation:none}}
    /* sfumatura sul bordo destro: fa capire che il nastro continua */
    .collezione{position:relative}
    .collezione::after{content:'';position:absolute;right:0;bottom:0;width:clamp(2rem,6vw,5rem);height:calc(100% - 1px);
      background:linear-gradient(90deg,rgba(247,243,236,0),var(--avorio));pointer-events:none}

    /* ---------- atelier ---------- */
    .atelier{padding:clamp(4.5rem,10vw,8rem) 0}
    .atelier-in{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(2.5rem,6vw,5rem);align-items:start}
    .atelier-in>*{min-width:0}
    .atelier-q{font-family:var(--disp);font-size:clamp(2.2rem,4.6vw,3.6rem);line-height:1.14;color:var(--avorio);margin-top:1.5rem;letter-spacing:-.018em}
    .atelier-oro{color:var(--oro-c)}
    .atelier-link{color:var(--avorio);border-color:var(--oro-c)}
    .atelier-lista{list-style:none;margin:1.8rem 0;display:grid;gap:0}
    .atelier-lista li{padding:.85rem 0;border-bottom:1px solid var(--filo-c);font-size:.95rem;color:#b7ada0}
    .atelier-lista li:first-child{border-top:1px solid var(--filo-c)}
    .atelier-azioni{display:flex;align-items:center;gap:2rem;flex-wrap:wrap;margin-top:2rem}

    /* ---------- perizie ---------- */
    .perizie-in{text-align:center}
    .perizie-in h2{font-size:clamp(2.2rem,5vw,3.6rem);margin:1.5rem 0 0}
    .perizie-in>p{color:var(--grafite);margin:1.5rem auto 2.3rem;max-width:52ch}

    /* ---------- voce ---------- */
    .voce{padding-top:0}
    .voce-q{text-align:center;border-top:1px solid var(--filo);border-bottom:1px solid var(--filo);padding:clamp(2.5rem,6vw,4rem) 0}
    .voce-q p{font-family:var(--disp);font-style:italic;font-size:clamp(1.5rem,3.4vw,2.4rem);line-height:1.3;color:var(--inchiostro)}
    .voce-q footer{margin-top:1.5rem;font-size:.8rem;letter-spacing:.08em;color:var(--grigio)}
    .voce-st{color:var(--oro);letter-spacing:2px}

    /* ---------- visita ---------- */
    .visita-in{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(2.5rem,6vw,5rem);align-items:start}
    .visita-in>*{min-width:0}
    .visita-in h2{font-size:clamp(2rem,4.4vw,3.2rem);margin:1.4rem 0 0}
    .visita-p{color:var(--grafite);margin:1.4rem 0 2.2rem;max-width:48ch}
    .visita-azioni{display:flex;align-items:center;gap:2rem;flex-wrap:wrap}
    .visita-h3{font-family:var(--sans);font-size:.66rem;font-weight:500;letter-spacing:.24em;text-transform:uppercase;color:var(--oro);margin-bottom:1rem}

    @media (max-width:980px){
      .apertura{grid-template-columns:1fr;gap:2.5rem;padding-top:calc(var(--tastata) + 2rem)}
      .apertura-testo{padding-inline:clamp(1.2rem,5vw,3.2rem);justify-self:stretch;max-width:none}
      .apertura-foto img{height:clamp(300px,52vh,460px)}
      .mestieri a{grid-template-columns:auto 1fr;row-gap:.5rem}
      .mest-d{grid-column:2}
      .mest-fr{display:none}
      .atelier-in,.visita-in{grid-template-columns:1fr}
      .fiducia-ora{margin-left:0}
    }
  </style>

  <script>
    import { renderOrari } from './_shared.js';
    renderOrari(document.getElementById('listaOrari'), document.getElementById('statoTxt'));
  </script>
</Layout>
