---
import Layout from './_Layout.astro';
import { INFO, REPARTI, CATEGORIE, GIORNI, SETTIMANA } from './_shared.js';
// Area riservata al titolare: la selezione del momento (vetrina e home), gli orari
// di apertura e i marchi trattati.
// Nella versione reale l'accesso è protetto sul server; qui è una dimostrazione.
---
<Layout title="Area riservata" active="Riservata" desc="Area riservata al titolare: selezione del momento, orari e marchi trattati.">

  <!-- ACCESSO -->
  <section class="testa-pagina" id="accesso">
    <div class="misura accesso-in">
      <div class="intro centro a">
        <span class="occhiello centro">Area riservata</span>
        <h1>Il pannello <span class="it oro">del negozio</span></h1>
        <p>Accesso al pannello del negozio.</p>
      </div>
      <form class="modulo accesso-form a" id="loginForm">
        <label>Nome utente<input type="text" id="l-user" autocomplete="username" required /></label>
        <label>Password<input type="password" id="l-pass" autocomplete="current-password" required /></label>
        <p class="errore" id="lErr" hidden>Credenziali non corrette. Riprovate.</p>
        <button type="submit" class="btn btn-pieno">Accedi</button>
        <!-- ⚠ Solo per la bozza: da RIMUOVERE nella versione definitiva -->
        <button type="button" class="prova" id="lProva">
          <span class="prova-t">Credenziali di prova</span>
          <span class="prova-v">masgioielli · trapani146</span>
          <span class="prova-d">toccate qui per compilare — spariranno nella versione definitiva</span>
        </button>
        <p class="nota">Nella versione reale l’accesso è protetto sul server, con utenti e permessi.</p>
      </form>
    </div>
  </section>

  <!-- PANNELLO -->
  <section class="testa-pagina" id="pannello" hidden>
    <div class="misura">
      <div class="intro a">
        <span class="occhiello">Area riservata</span>
        <h1>Il pannello <span class="it oro">del negozio</span></h1>
        <p>Quello che cambiate qui compare subito sul sito. <button type="button" id="esci" class="esci">Esci dall’area riservata</button></p>
      </div>
    </div>

    <!-- SELEZIONE DEL MOMENTO -->
    <div class="misura blocco">
      <h2 class="blocco-t">La selezione del momento</h2>
      <p class="blocco-d">I pezzi che compaiono nella pagina «Selezione» e in home. Aggiungete una foto dal telefono, togliete quello che avete venduto: il primo in elenco è il primo che si vede.</p>
    </div>
    <div class="misura pann-in">
      <form class="modulo" id="pezzoForm">
        <h3 class="form-t">Nuovo pezzo</h3>
        <label>Fotografia<input type="file" id="z-foto" accept="image/*" /></label>
        <img id="zAnteprima" class="z-anteprima" alt="Anteprima della foto scelta" hidden />
        <label>Nome<input type="text" id="z-nome" required maxlength="50" placeholder="Es. Anello trilogy" /></label>
        <label>Categoria
          <select id="z-cat">{CATEGORIE.map((c) => <option>{c}</option>)}</select>
        </label>
        <label>Materiale <small>(facoltativo)</small><input type="text" id="z-mat" maxlength="80" placeholder="Es. Oro bianco 18kt · diamanti" /></label>
        <label>Due righe di descrizione <small>(facoltative)</small><textarea id="z-desc" rows="3" maxlength="300"></textarea></label>
        <p class="errore" id="zErr" role="alert" hidden></p>
        <button type="submit" class="btn btn-pieno">Metti in vetrina</button>
      </form>
      <div>
        <h3 class="form-t">In vetrina adesso</h3>
        <ul class="elenco" id="elencoPezzi"></ul>
        <div class="pann-azioni">
          <a href="/demoMasGioielli/vetrina/" class="btn btn-vuoto">Guarda la selezione</a>
          <button type="button" class="ripristina" id="ripristinaPezzi">Ripristina gli esempi</button>
        </div>
      </div>
    </div>

    <!-- ORARI -->
    <div class="misura blocco" id="orari">
      <h2 class="blocco-t">Orari di apertura</h2>
      <p class="blocco-d">Si aggiornano da soli in home, nella pagina Contatti, nel piede di ogni pagina e nell’indicatore «aperto ora». Per l’orario continuato lasciate vuoto il pomeriggio.</p>
    </div>
    <div class="misura">
      <form class="orari-form" id="orariForm" novalidate>
        <table class="orari-tab">
          <thead><tr><th scope="col">Giorno</th><th scope="col">Aperto</th><th scope="col">Mattina</th><th scope="col">Pomeriggio</th></tr></thead>
          <tbody>
            {SETTIMANA.map((i) => (
              <tr data-g={i}>
                <th scope="row">{GIORNI[i]}</th>
                <td><label class="o-ap"><input type="checkbox" class="o-aperto" /><span>Aperto</span></label></td>
                <td><span class="o-fascia"><input type="time" class="o-a1" step="900" aria-label={GIORNI[i] + ', mattina: apre alle'} /><span aria-hidden="true">–</span><input type="time" class="o-b1" step="900" aria-label={GIORNI[i] + ', mattina: chiude alle'} /></span></td>
                <td><span class="o-fascia"><input type="time" class="o-a2" step="900" aria-label={GIORNI[i] + ', pomeriggio: apre alle'} /><span aria-hidden="true">–</span><input type="time" class="o-b2" step="900" aria-label={GIORNI[i] + ', pomeriggio: chiude alle'} /></span></td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="errore" id="oErr" role="alert" hidden></p>
        <div class="pann-azioni">
          <button type="submit" class="btn">Salva gli orari</button>
          <a href="/demoMasGioielli/contatti/" class="btn btn-vuoto">Guarda come appaiono</a>
          <button type="button" class="ripristina" id="ripristinaOrari">Ripristina gli orari di sempre</button>
          <span class="o-ok" id="oOk" role="status"></span>
        </div>
      </form>
    </div>

    <!-- MARCHI -->
    <div class="misura blocco">
      <h2 class="blocco-t">I marchi che trattate</h2>
      <p class="blocco-d">Compaiono nella fascia in home page.</p>
    </div>

    <div class="misura pann-in">
      <form class="modulo a" id="brandForm">
        <h3 id="formTitolo" class="form-t">Nuovo marchio</h3>
        <label>Nome del marchio<input type="text" id="b-nome" required maxlength="40" placeholder="Es. Orsini 1912" /></label>
        <label>Reparto
          <select id="b-reparto">
            {REPARTI.map((r) => <option>{r}</option>)}
          </select>
        </label>
        <label>Nota interna <small>(facoltativa, non compare sul sito)</small>
          <input type="text" id="b-nota" maxlength="80" placeholder="Es. rivenditore autorizzato dal 2018" />
        </label>
        <button type="submit" class="btn btn-pieno" id="salva">Aggiungi il marchio</button>
        <button type="button" class="annulla" id="annulla" hidden>Annulla la modifica</button>
        <p class="nota">Dimostrazione: i marchi restano su questo dispositivo. Nella versione reale sono salvati sul sito e visibili a tutti.</p>
      </form>

      <div class="a">
        <h3 class="form-t">Marchi in elenco</h3>
        <ul class="elenco" id="elenco"></ul>
        <div class="pann-azioni">
          <a href="/demoMasGioielli/" class="btn btn-vuoto">Guarda come appaiono in home</a>
          <button type="button" class="ripristina" id="ripristina">Ripristina gli esempi</button>
        </div>
      </div>
    </div>

    <div class="misura">
      <p class="promemoria">💡 <b>Per il titolare:</b> in questa bozza selezione e marchi restano su questo dispositivo. Nella versione definitiva sono salvati sul sito e li vedono tutti: si carica una volta e il sito si aggiorna da solo.</p>
    </div>
  </section>

  <style>
    .testa-pagina{padding-top:calc(var(--tastata) + clamp(2.5rem,6vw,4.5rem));padding-bottom:clamp(2.5rem,5vw,4rem)}
    /* qui si lavora: il titolo non deve occupare mezzo schermo come in vetrina */
    #pannello .intro h1{font-size:clamp(2.2rem,4.2vw,3.2rem)}
    #pannello .intro p{margin-top:1rem}

    /* accesso */
    .accesso-in{max-width:420px;margin-inline:auto}
    .accesso-form{margin-top:2.5rem}
    .errore{color:#a4442c;font-size:.85rem}
    .prova{display:grid;gap:.3rem;text-align:center;background:var(--carta);border:1px dashed var(--oro);padding:1rem;cursor:pointer;font-family:inherit;transition:background .25s}
    .prova:hover{background:var(--avorio-2)}
    .prova-t{font-size:.64rem;letter-spacing:.24em;text-transform:uppercase;color:var(--oro)}
    .prova-v{font-family:var(--disp);font-size:1.25rem;color:var(--inchiostro)}
    .prova-d{font-size:.74rem;color:var(--grigio)}

    /* pannello */
    .esci{background:none;border:0;padding:0;font:inherit;font-size:.9rem;color:var(--oro);cursor:pointer;border-bottom:1px solid var(--oro)}
    .pann-in{display:grid;grid-template-columns:.95fr 1.05fr;gap:clamp(2.5rem,6vw,5rem);align-items:start;margin-top:clamp(2rem,4vw,3rem)}
    .pann-in>*{min-width:0}
    .form-t{font-size:clamp(1.5rem,2.8vw,2rem);margin-bottom:.4rem}
    .modulo small{letter-spacing:0;text-transform:none;font-weight:400;color:var(--grigio)}
    .annulla{background:none;border:0;color:var(--grigio);font-size:.8rem;text-decoration:underline;cursor:pointer;font-family:inherit}
    .annulla:hover{color:#a4442c}

    .elenco{list-style:none;margin-top:1.4rem;border-top:1px solid var(--filo)}
    /* :global — le righe sono iniettate via JS e non ricevono lo scope di Astro */
    :global(.el-riga){display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--filo)}
    :global(.el-riga.in-modifica){background:var(--carta);box-shadow:-12px 0 0 var(--carta),12px 0 0 var(--carta)}
    :global(.el-tx b){display:block;font-family:var(--disp);font-weight:400;font-size:1.35rem;line-height:1.2}
    :global(.el-tx span){font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:var(--oro)}
    :global(.el-tx i){display:block;font-size:.82rem;color:var(--grigio);font-style:normal}
    :global(.el-riga button){background:none;border:1px solid var(--filo);width:34px;height:34px;cursor:pointer;color:var(--grafite);font-size:.85rem;transition:border-color .25s,color .25s}
    :global(.el-riga button:hover){border-color:var(--oro);color:var(--oro)}
    :global(.el-riga .el-del:hover){border-color:#a4442c;color:#a4442c}
    :global(.el-vuoto){padding:2.2rem 0;color:var(--grigio);font-family:var(--disp);font-style:italic;font-size:1.25rem;text-align:center;border-bottom:1px solid var(--filo)}
    .pann-azioni{display:flex;align-items:center;gap:2rem;flex-wrap:wrap;margin-top:2rem}
    .ripristina{background:none;border:0;color:var(--grigio);font-size:.8rem;text-decoration:underline;cursor:pointer;font-family:inherit}
    .ripristina:hover{color:var(--oro)}

    .blocco{margin-top:clamp(3rem,6vw,4.5rem);padding-top:clamp(2rem,4vw,2.8rem);border-top:1px solid var(--filo)}
    .blocco-t{font-size:clamp(1.9rem,3.6vw,2.7rem)}
    .blocco-d{color:var(--grafite);margin-top:.5rem;max-width:62ch}
    .z-anteprima{width:120px;aspect-ratio:4/5;object-fit:cover;border:1px solid var(--filo)}
    :global(.el-riga.con-foto){grid-template-columns:56px 1fr auto auto}
    :global(.el-riga.con-foto img){width:56px;height:70px;object-fit:cover}
    :global(.el-riga button:disabled){opacity:.3;cursor:default}
    /* orari */
    .orari-tab{width:100%;border-collapse:collapse;margin-top:.4rem}
    .orari-tab th,.orari-tab td{text-align:left;padding:.75rem .6rem .75rem 0;border-bottom:1px solid var(--filo);vertical-align:middle}
    .orari-tab thead th{font-size:.66rem;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:var(--grigio)}
    .orari-tab tbody th{font-family:var(--disp);font-weight:400;font-size:1.25rem;color:var(--inchiostro);white-space:nowrap}
    .o-ap{display:inline-flex;align-items:center;gap:.5rem;cursor:pointer;font-size:.9rem;color:var(--grafite)}
    .o-ap input{width:18px;height:18px;accent-color:var(--oro)}
    .o-fascia{display:inline-flex;align-items:center;gap:.5rem}
    .o-fascia input{padding:.45rem .5rem;border:1px solid var(--filo);background:var(--carta);font:inherit;font-size:.95rem;color:var(--inchiostro);min-width:0}
    .o-fascia input:disabled{opacity:.35}
    .o-fascia input[aria-invalid="true"]{border-color:#a4442c;background:#fbf0ec}
    tr.chiuso .o-fascia{opacity:.45}
    .o-ok{color:#3c6e47;font-size:.88rem}
    @media (max-width:700px){
      .orari-tab thead{display:none}
      .orari-tab,.orari-tab tbody,.orari-tab tr,.orari-tab th,.orari-tab td{display:block;width:100%}
      .orari-tab tr{padding:.8rem 0;border-bottom:1px solid var(--filo)}
      .orari-tab th,.orari-tab td{border:0;padding:.25rem 0}
      .orari-tab td:nth-child(3)::before{content:'Mattina';display:block;font-size:.66rem;letter-spacing:.2em;text-transform:uppercase;color:var(--grigio);margin:.3rem 0}
      .orari-tab td:nth-child(4)::before{content:'Pomeriggio';display:block;font-size:.66rem;letter-spacing:.2em;text-transform:uppercase;color:var(--grigio);margin:.3rem 0}
    }
    @media (max-width:900px){.pann-in{grid-template-columns:1fr}}
  </style>

  <script>
    import { BRAND_BASE, leggiBrand, scriviBrand, esc, salvaSessione, PEZZI, leggiSelezione, scriviSelezione, orariAttivi, scriviOrari, cancellaOrari, GIORNI } from './_shared.js';
    const $ = (s) => document.querySelector(s);

    /* ---- accesso (nella versione reale: autenticazione lato server) ---- */
    const USER = 'masgioielli', PASS = 'trapani146';
    const secAccesso = $('#accesso'), secPannello = $('#pannello');
    const gate = () => {
      const dentro = sessionStorage.getItem('mas-auth') === 'ok';
      secAccesso.hidden = dentro;
      secPannello.hidden = !dentro;
    };
    $('#loginForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const u = $('#l-user').value.trim().toLowerCase();
      const p = $('#l-pass').value;
      if (u === USER && p === PASS) { salvaSessione('mas-auth', 'ok'); $('#lErr').hidden = true; gate(); }
      else $('#lErr').hidden = false;
    });
    $('#lProva').addEventListener('click', () => { $('#l-user').value = USER; $('#l-pass').value = PASS; $('#l-pass').focus(); });
    $('#esci').addEventListener('click', () => { sessionStorage.removeItem('mas-auth'); gate(); window.scrollTo({ top: 0 }); });
    gate();

    /* ---- marchi ---- */
    // se non ha mai salvato nulla parto dagli esempi, così vede subito com'è fatto
    let marchi = leggiBrand() ?? BRAND_BASE.map((b) => ({ ...b }));
    let inModifica = null;

    const elenco = $('#elenco'), form = $('#brandForm');
    const setModo = (mod) => {
      $('#formTitolo').textContent = mod ? 'Modifica marchio' : 'Nuovo marchio';
      $('#salva').textContent = mod ? 'Salva le modifiche' : 'Aggiungi il marchio';
      $('#annulla').hidden = !mod;
    };
    const reset = () => { form.reset(); inModifica = null; setModo(false); };

    const render = () => {
      elenco.innerHTML = marchi.length
        ? marchi.map((b) => `<li class="el-riga${b.id === inModifica ? ' in-modifica' : ''}">
            <div class="el-tx"><span>${esc(b.reparto || '')}</span><b>${esc(b.nome)}</b>${b.nota ? `<i>${esc(b.nota)}</i>` : ''}</div>
            <button type="button" class="el-mod" data-mod="${esc(b.id)}" aria-label="Modifica ${esc(b.nome)}">✎</button>
            <button type="button" class="el-del" data-del="${esc(b.id)}" aria-label="Elimina ${esc(b.nome)}">✕</button>
          </li>`).join('')
        : '<li class="el-vuoto">Nessun marchio in elenco.<br/>In home comparirà una frase generica al posto della fascia.</li>';

      elenco.querySelectorAll('[data-del]').forEach((b) => b.addEventListener('click', () => {
        marchi = marchi.filter((m) => m.id !== b.dataset.del);
        if (inModifica === b.dataset.del) reset();
        scriviBrand(marchi); render();
      }));
      elenco.querySelectorAll('[data-mod]').forEach((b) => b.addEventListener('click', () => {
        const m = marchi.find((x) => x.id === b.dataset.mod);
        if (!m) return;
        $('#b-nome').value = m.nome; $('#b-reparto').value = m.reparto || 'Gioielleria'; $('#b-nota').value = m.nota || '';
        inModifica = m.id; setModo(true); render();
        $('#b-nome').focus();
        form.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }));
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const nome = $('#b-nome').value.trim();
      if (!nome) return;
      const dati = { nome, reparto: $('#b-reparto').value, nota: $('#b-nota').value.trim() };
      if (inModifica) marchi = marchi.map((m) => (m.id === inModifica ? { ...m, ...dati } : m));
      else marchi = [...marchi, { id: 'm' + Date.now(), ...dati }];
      scriviBrand(marchi); reset(); render();
    });
    $('#annulla').addEventListener('click', () => { reset(); render(); });
    $('#ripristina').addEventListener('click', () => {
      marchi = BRAND_BASE.map((b) => ({ ...b }));
      scriviBrand(marchi); reset(); render();
    });

    setModo(false); render();

    /* ---- selezione del momento ---- */
    let pezzi = leggiSelezione()?.pezzi ?? PEZZI.map((x) => ({ ...x }));
    const elencoPezzi = $('#elencoPezzi'), zErr = $('#zErr');
    const errore = (m) => { zErr.textContent = m; zErr.hidden = !m; };
    const salvaPezzi = () => {
      const ok = scriviSelezione({ pezzi, agg: new Date().toISOString() });
      errore(ok ? '' : 'Non c’è più spazio su questo dispositivo: togliete qualche pezzo e riprovate.');
      return ok;
    };
    const renderPezzi = () => {
      elencoPezzi.innerHTML = pezzi.length
        ? pezzi.map((x, i) => `<li class="el-riga con-foto">
            <img src="${esc(x.img)}" alt="" width="56" height="70" />
            <div class="el-tx"><span>${esc(x.cat)}</span><b>${esc(x.nome)}</b>${x.materiale ? `<i>${esc(x.materiale)}</i>` : ''}</div>
            <button type="button" data-su="${i}" aria-label="Porta ${esc(x.nome)} in cima"${i === 0 ? ' disabled' : ''}>↑</button>
            <button type="button" class="el-del" data-via="${i}" aria-label="Togli ${esc(x.nome)} dalla vetrina">✕</button>
          </li>`).join('')
        : '<li class="el-vuoto">La vetrina è vuota.<br/>Sul sito comparirà «Stiamo rinnovando la selezione».</li>';
      elencoPezzi.querySelectorAll('[data-via]').forEach((b) => b.addEventListener('click', () => {
        pezzi.splice(+b.dataset.via, 1); salvaPezzi(); renderPezzi();
      }));
      elencoPezzi.querySelectorAll('[data-su]').forEach((b) => b.addEventListener('click', () => {
        const [x] = pezzi.splice(+b.dataset.su, 1); pezzi.unshift(x); salvaPezzi(); renderPezzi();
      }));
    };

    // La foto del telefono pesa diversi MB: la riduco a 900 px sul lato lungo prima di salvarla.
    let fotoPronta = '';
    const riduci = (file) => new Promise((ok, ko) => {
      const img = new Image();
      img.onload = () => {
        const k = Math.min(1, 900 / Math.max(img.width, img.height));
        const c = document.createElement('canvas');
        c.width = Math.round(img.width * k); c.height = Math.round(img.height * k);
        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
        URL.revokeObjectURL(img.src);
        ok(c.toDataURL('image/jpeg', 0.82));
      };
      img.onerror = () => ko(new Error('foto'));
      img.src = URL.createObjectURL(file);
    });
    $('#z-foto').addEventListener('change', async (e) => {
      const f = e.target.files && e.target.files[0];
      fotoPronta = '';
      $('#zAnteprima').hidden = true;
      if (!f) return;
      try {
        fotoPronta = await riduci(f);
        $('#zAnteprima').src = fotoPronta; $('#zAnteprima').hidden = false; errore('');
      } catch { errore('Questa foto non si riesce ad aprire: provate con un’altra.'); }
    });
    $('#pezzoForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const nome = $('#z-nome').value.trim();
      if (!fotoPronta) { errore('Scegliete prima una fotografia.'); return; }
      if (!nome) return;
      const nuovo = { id: 'z' + Date.now(), nome, cat: $('#z-cat').value, img: fotoPronta, alt: nome,
        materiale: $('#z-mat').value.trim(), desc: $('#z-desc').value.trim() };
      pezzi.unshift(nuovo);
      if (!salvaPezzi()) { pezzi.shift(); return; }
      e.target.reset(); fotoPronta = ''; $('#zAnteprima').hidden = true; renderPezzi();
    });
    $('#ripristinaPezzi').addEventListener('click', () => { pezzi = PEZZI.map((x) => ({ ...x })); salvaPezzi(); renderPezzi(); });
    renderPezzi();

    /* ---- orari di apertura ---- */
    // "09:30" <-> 9.5
    const ore = (v) => { const [h, m] = v.split(':').map(Number); return h + m / 60; };
    const hhmm = (x) => `${String(Math.floor(x)).padStart(2, '0')}:${String(Math.round((x % 1) * 60)).padStart(2, '0')}`;
    const righeOrari = [...document.querySelectorAll('#orariForm tbody tr')];
    const statoRiga = (tr) => {
      const aperto = tr.querySelector('.o-aperto').checked;
      tr.classList.toggle('chiuso', !aperto);
      tr.querySelectorAll('input[type=time]').forEach((i) => { i.disabled = !aperto; });
    };
    const riempiOrari = () => {
      const o = orariAttivi();
      righeOrari.forEach((tr) => {
        const f = o[+tr.dataset.g];
        tr.querySelector('.o-aperto').checked = !!f;
        tr.querySelector('.o-a1').value = f ? hhmm(f[0][0]) : '';
        tr.querySelector('.o-b1').value = f ? hhmm(f[0][1]) : '';
        tr.querySelector('.o-a2').value = f && f[1] ? hhmm(f[1][0]) : '';
        tr.querySelector('.o-b2').value = f && f[1] ? hhmm(f[1][1]) : '';
        statoRiga(tr);
      });
    };
    righeOrari.forEach((tr) => tr.querySelector('.o-aperto').addEventListener('change', () => {
      statoRiga(tr);
      // aprendo un giorno chiuso propongo l'orario solito, da ritoccare se serve
      if (tr.querySelector('.o-aperto').checked && !tr.querySelector('.o-a1').value) {
        tr.querySelector('.o-a1').value = '09:30'; tr.querySelector('.o-b1').value = '12:30';
        tr.querySelector('.o-a2').value = '15:30'; tr.querySelector('.o-b2').value = '19:30';
      }
    }));
    const oErr = $('#oErr'), oOk = $('#oOk');
    $('#orariForm').addEventListener('submit', (e) => {
      e.preventDefault();
      oOk.textContent = '';
      document.querySelectorAll('#orariForm [aria-invalid]').forEach((i) => i.removeAttribute('aria-invalid'));
      const nuovi = {};
      for (const tr of righeOrari) {
        const g = +tr.dataset.g, nome = GIORNI[g];
        if (!tr.querySelector('.o-aperto').checked) { nuovi[g] = null; continue; }
        const [a1, b1, a2, b2] = ['.o-a1', '.o-b1', '.o-a2', '.o-b2'].map((s) => tr.querySelector(s));
        const sbaglia = (campo, msg) => { campo.setAttribute('aria-invalid', 'true'); campo.focus(); oErr.textContent = msg; oErr.hidden = false; };
        if (!a1.value || !b1.value) return sbaglia(a1.value ? b1 : a1, `${nome}: scrivete a che ora aprite e chiudete la mattina.`);
        if (ore(a1.value) >= ore(b1.value)) return sbaglia(b1, `${nome}: la chiusura della mattina viene prima dell’apertura.`);
        const fasce = [[ore(a1.value), ore(b1.value)]];
        if (a2.value || b2.value) {
          if (!a2.value || !b2.value) return sbaglia(a2.value ? b2 : a2, `${nome}: il pomeriggio va completato, oppure lasciato tutto vuoto per l’orario continuato.`);
          if (ore(a2.value) >= ore(b2.value)) return sbaglia(b2, `${nome}: la chiusura del pomeriggio viene prima dell’apertura.`);
          if (ore(a2.value) < ore(b1.value)) return sbaglia(a2, `${nome}: il pomeriggio comincia prima che finisca la mattina.`);
          fasce.push([ore(a2.value), ore(b2.value)]);
        }
        nuovi[g] = fasce;
      }
      oErr.hidden = true;
      oOk.textContent = scriviOrari(nuovi) ? '✓ Orari salvati: il sito è già aggiornato.' : 'Non riesco a salvare su questo dispositivo.';
    });
    $('#ripristinaOrari').addEventListener('click', () => { cancellaOrari(); riempiOrari(); oErr.hidden = true; oOk.textContent = 'Ripristinati gli orari di sempre.'; });
    riempiOrari();
  </script>
</Layout>
