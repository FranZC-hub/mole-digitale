---
import Layout from './_Layout.astro';
import { INFO } from './_shared.js';
// Perizie: il servizio distintivo. Contesto spesso delicato (successioni, lutti):
// tono sobrio, nessuna pressione commerciale, riservatezza in primo piano.
const casi = [
  { ic: '⚖', t: 'Successioni', d: 'La valutazione dei gioielli da inserire nella dichiarazione di successione, con un documento chiaro da consegnare al notaio o al commercialista.' },
  { ic: '👥', t: 'Divisioni ereditarie', d: 'Quando i beni vanno divisi tra più eredi serve un valore terzo e imparziale, uguale per tutti. Ce ne occupiamo noi.' },
  { ic: '🔐', t: 'Apertura di cassette di sicurezza', d: 'Siamo presenti all\'apertura e redigiamo l\'inventario con la stima pezzo per pezzo, anche alla presenza del notaio.' },
  { ic: '🛡', t: 'Assicurazione', d: 'Per assicurare un pezzo di valore serve una stima aggiornata: senza, in caso di furto o perdita il rimborso è un problema.' },
];
---
<Layout title="Perizie e valutazioni" active="Perizie" desc={`Perizie e valutazioni di gioielli e orologi a Torino: successioni, divisioni ereditarie, cassette di sicurezza e assicurazioni. ${INFO.nome}, dal ${INFO.fondata}, con la massima discrezione.`}>
  <section class="msection" style="padding-top:8rem;">
    <div class="mhead mhead-c r">
      <span class="mkick">Perizie e valutazioni</span>
      <h1>Sapere quanto vale, <span class="oro it">con discrezione</span></h1>
      <p>Dal {INFO.fondata} mettiamo l'esperienza del banco al servizio di chi ha bisogno di una valutazione seria: per una successione, una divisione tra eredi o semplicemente per sapere.</p>
    </div>

    <div class="disc r">
      <span class="disc-ic" aria-hidden="true">🤐</span>
      <p><b>Massima riservatezza.</b> Quello che ci portate resta tra noi. Non chiediamo perché, non diciamo a nessuno, non vi chiameremo per vendervi qualcosa. Se preferite, riceviamo fuori orario a negozio chiuso.</p>
    </div>

    <h2 class="sr-only">Quando serve una perizia</h2>
    <div class="casi-grid">
      {casi.map((c) => (
        <article class="mcard r">
          <span class="mic" aria-hidden="true">{c.ic}</span>
          <h3>{c.t}</h3>
          <p>{c.d}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- COME FUNZIONA -->
  <section class="msection sec-come">
    <div class="mhead mhead-c r">
      <span class="mkick">Come funziona</span>
      <h2>Tre passaggi, <span class="oro it">nessuna sorpresa</span></h2>
    </div>
    <h3 class="sr-only">I passaggi della perizia</h3>
    <ol class="passi">
      <li class="r"><span class="passo-n">1</span><div><b>Ci sentiamo</b><p>Ci dite di cosa si tratta e quanti pezzi sono, anche solo per messaggio. Vi diciamo subito se serve davvero una perizia o basta una stima verbale — gratuita.</p></div></li>
      <li class="r"><span class="passo-n">2</span><div><b>Guardiamo i pezzi</b><p>In negozio, o dove sono custoditi se non si possono spostare. Pesiamo, misuriamo le pietre e fotografiamo tutto davanti a voi.</p></div></li>
      <li class="r"><span class="passo-n">3</span><div><b>Vi consegniamo il documento</b><p>Una perizia scritta e firmata, con foto e valore di ogni pezzo: pronta da consegnare al notaio, al commercialista o all'assicurazione.</p></div></li>
    </ol>
  </section>

  <!-- RICHIESTA RISERVATA -->
  <section class="msection sec-form" id="richiesta">
    <div class="rich-grid">
      <div class="r">
        <span class="mkick">Richiesta riservata</span>
        <h2>Raccontateci <span class="oro it">di cosa si tratta</span></h2>
        <p class="rich-p">Poche righe, senza impegno. Vi rispondiamo noi in prima persona, di solito in giornata. Se il momento è delicato, scriveteci pure solo l'essenziale: al resto pensiamo quando ci vediamo.</p>
        <ul class="rich-list">
          <li>La prima stima verbale è <b>sempre gratuita</b></li>
          <li>Il costo della perizia scritta ve lo diciamo <b>prima</b> di iniziare</li>
          <li>Possiamo ricevervi <b>a negozio chiuso</b>, su appuntamento</li>
        </ul>
        <p class="rich-tel">Preferite parlarne a voce? <a href={'tel:' + INFO.telHref}>{INFO.tel}</a></p>
      </div>

      <form class="mform r" id="perForm">
        <label>Di che tipo di valutazione avete bisogno?
          <select id="q-tipo">
            <option>Successione</option>
            <option>Divisione tra eredi</option>
            <option>Apertura di cassetta di sicurezza</option>
            <option>Assicurazione</option>
            <option>Solo per sapere quanto vale</option>
          </select>
        </label>
        <div class="rich-row">
          <label>Quanti pezzi, all'incirca?
            <select id="q-pezzi">
              <option>1–3</option><option>4–10</option><option>11–30</option><option>Più di 30</option><option>Non lo so ancora</option>
            </select>
          </label>
          <label>Dove si trovano?
            <select id="q-dove">
              <option>Li porto in negozio</option>
              <option>In una cassetta di sicurezza</option>
              <option>A casa, non si possono spostare</option>
            </select>
          </label>
        </div>
        <label>Il vostro nome
          <input type="text" id="q-nome" required autocomplete="name" placeholder="Come vi chiamate" />
        </label>
        <label>Telefono
          <input type="tel" id="q-tel" required autocomplete="tel" placeholder="Per richiamarvi" />
        </label>
        <label>Volete aggiungere qualcosa? <small>(facoltativo)</small>
          <textarea id="q-note" rows="3" maxlength="500" placeholder="Es. sono gioielli di mia madre, vorrei capire come muovermi"></textarea>
        </label>
        <label class="mconsent">
          <input type="checkbox" id="q-privacy" required />
          <span>Ho letto l'<a href="/demoMasGioielli/privacy/">informativa privacy</a> e acconsento al trattamento dei dati per essere ricontattato.</span>
        </label>
        <button type="submit" class="mbtn mbtn-oro mbtn-block mbtn-lg">Invia la richiesta →</button>
        <p class="mform-ok" id="perOk" role="status" aria-live="polite"></p>
        <p class="mform-note">Bozza dimostrativa: nella versione reale la richiesta arriva subito al negozio (email + WhatsApp), senza passare da nessun altro.</p>
      </form>
    </div>

    <p class="md-hint r">💡 <b>Per il titolare:</b> è il modulo che porta il lavoro più redditizio. Chi cerca «perizia gioielli successione Torino» oggi non vi trova: con questa pagina indicizzata, sì.</p>
  </section>

  <style>
    .disc{display:flex;gap:1.1rem;align-items:flex-start;max-width:860px;margin:0 auto 3rem;background:rgba(201,162,74,.07);border:1px solid var(--oro-d);border-radius:3px;padding:1.4rem 1.6rem}
    .disc-ic{font-size:1.6rem;flex:none;line-height:1}
    .disc p{color:var(--muted);font-size:.98rem}
    .disc b{color:var(--panna)}

    .casi-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.2rem;max-width:940px;margin:0 auto}
    .casi-grid>*{min-width:0}

    .sec-come{padding-top:1rem}
    .passi{list-style:none;display:grid;gap:1.2rem;max-width:820px;margin:0 auto;counter-reset:p}
    .passi li{display:flex;gap:1.2rem;align-items:flex-start;background:var(--card);border:1px solid var(--linea);border-radius:3px;padding:1.5rem 1.6rem}
    .passo-n{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--oro);color:#1a1408;font-weight:800;flex:none}
    .passi b{display:block;font-family:var(--disp);font-size:1.4rem;margin-bottom:.25rem}
    .passi p{color:var(--muted);font-size:.95rem}

    .sec-form{padding-top:1rem}
    .rich-grid{display:grid;grid-template-columns:.95fr 1.05fr;gap:clamp(1.6rem,4vw,3rem);align-items:start;max-width:1000px;margin:0 auto}
    .rich-grid>*{min-width:0}
    .rich-grid h2{font-size:clamp(1.9rem,4vw,2.8rem);margin:.5rem 0 1rem}
    .rich-p{color:var(--muted);margin-bottom:1.4rem}
    .rich-list{list-style:none;display:grid;gap:.7rem;margin-bottom:1.4rem}
    .rich-list li{color:var(--muted);font-size:.95rem;padding-left:1.4rem;position:relative}
    .rich-list li::before{content:'✓';position:absolute;left:0;color:var(--oro)}
    .rich-list b{color:var(--panna)}
    .rich-tel{color:var(--muted);font-size:.95rem}
    .rich-tel a{color:var(--oro-l);font-weight:700;text-decoration:underline}
    .rich-row{display:grid;grid-template-columns:1fr 1fr;gap:.9rem}
    .rich-row>*{min-width:0}
    .mform small{font-weight:400;text-transform:none;letter-spacing:0;color:var(--muted-2)}

    @media (max-width:860px){
      .casi-grid{grid-template-columns:1fr}
      .rich-grid{grid-template-columns:1fr}
      .rich-row{grid-template-columns:1fr}
    }
  </style>

  <script>
    document.getElementById('perForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const v = (id) => document.getElementById(id).value.trim();
      const ok = document.getElementById('perOk');
      ok.innerHTML = `✅ Richiesta registrata, <b>${v('q-nome') || 'grazie'}</b>. Vi richiamiamo allo <b>${v('q-tel')}</b>, di solito in giornata. <i>(demo: nessun dato è stato inviato)</i>`;
      ok.style.display = 'block';
      ok.scrollIntoView({ behavior: 'smooth', block: 'center' });
      e.target.reset();
    });
  </script>
</Layout>
