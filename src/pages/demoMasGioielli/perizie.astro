---
import Layout from './_Layout.astro';
import { INFO } from './_shared.js';
// Perizie: il servizio distintivo. Contesto spesso delicato (successioni, lutti):
// tono sobrio, nessuna pressione commerciale, riservatezza in primo piano.
const casi = [
  { t: 'Successioni', d: 'La valutazione dei gioielli da inserire nella dichiarazione di successione, con un documento chiaro da consegnare al notaio o al commercialista.' },
  { t: 'Divisioni ereditarie', d: 'Quando i beni vanno divisi tra più eredi serve un valore terzo e imparziale, uguale per tutti. Ce ne occupiamo noi.' },
  { t: 'Cassette di sicurezza', d: 'Siamo presenti all’apertura e redigiamo l’inventario con la stima pezzo per pezzo, anche alla presenza del notaio.' },
  { t: 'Assicurazione', d: 'Per assicurare un pezzo di valore serve una stima aggiornata: senza, in caso di furto o perdita il rimborso diventa un problema.' },
];
const passi = [
  { n: 'I', t: 'Ci sentiamo', d: 'Ci dite di cosa si tratta e quanti pezzi sono, anche solo per messaggio. Vi diciamo subito se serve davvero una perizia o basta una stima verbale — gratuita.' },
  { n: 'II', t: 'Guardiamo i pezzi', d: 'In negozio, oppure dove sono custoditi se non si possono spostare. Pesiamo, misuriamo le pietre e fotografiamo tutto davanti a voi.' },
  { n: 'III', t: 'Vi consegniamo il documento', d: 'Una perizia scritta e firmata, con foto e valore di ogni pezzo: pronta per il notaio, il commercialista o l’assicurazione.' },
];
---
<Layout title="Perizie e valutazioni" active="Perizie" desc={`Perizie e valutazioni di gioielli e orologi a Torino: successioni, divisioni ereditarie, cassette di sicurezza e assicurazioni. ${INFO.nome}, dal ${INFO.fondata}, con la massima discrezione.`}>

  <section class="testa-pagina">
    <div class="misura stretta intro centro a">
      <span class="occhiello centro">Perizie e valutazioni</span>
      <h1>Sapere quanto vale,<br/><span class="it oro">con discrezione</span></h1>
      <p>Dal {INFO.fondata} mettiamo l’esperienza del banco al servizio di chi ha bisogno di una valutazione seria: per una successione, una divisione tra eredi, o semplicemente per sapere.</p>
    </div>
  </section>

  <!-- RISERVATEZZA -->
  <section class="scuro banda riserbo">
    <div class="misura stretta a">
      <span class="occhiello centro riserbo-occ">Il nostro impegno</span>
      <p class="riserbo-t">«Quello che ci portate <span class="it riserbo-oro">resta tra noi.</span>»</p>
      <p class="riserbo-d">Non chiediamo perché. Non ne parliamo con nessuno. Non vi chiameremo per vendervi qualcosa. Se preferite, vi riceviamo fuori orario, a negozio chiuso.</p>
    </div>
  </section>

  <!-- QUANDO SERVE -->
  <section class="banda">
    <div class="misura">
      <div class="intro a">
        <span class="occhiello">Quando serve</span>
        <h2>Quattro casi<br/>in cui vi serviamo.</h2>
      </div>
      <h3 class="sr-only">Quando serve una perizia</h3>
      <div class="casi">
        {casi.map((c) => (
          <article class="caso a"><h4>{c.t}</h4><p>{c.d}</p></article>
        ))}
      </div>
    </div>
  </section>

  <!-- COME FUNZIONA -->
  <section class="banda passi-banda">
    <div class="misura">
      <div class="intro centro a">
        <span class="occhiello centro">Come funziona</span>
        <h2>Tre passaggi,<br/><span class="it oro">nessuna sorpresa.</span></h2>
      </div>
      <h3 class="sr-only">I passaggi della perizia</h3>
      <ol class="passi">
        {passi.map((p) => (
          <li class="a"><span class="passo-n">{p.n}</span><b>{p.t}</b><p>{p.d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- RICHIESTA RISERVATA -->
  <section class="banda" id="richiesta">
    <div class="misura rich-in">
      <div class="a">
        <span class="occhiello">Richiesta riservata</span>
        <h2 class="rich-h2">Raccontateci<br/><span class="it oro">di cosa si tratta.</span></h2>
        <p class="rich-p">Poche righe, senza impegno. Vi rispondiamo noi in prima persona, di solito in giornata. Se il momento è delicato, scriveteci pure solo l’essenziale: al resto pensiamo quando ci vediamo.</p>
        <ul class="rich-punti">
          <li>La prima stima verbale è <b>sempre gratuita</b></li>
          <li>Il costo della perizia scritta ve lo diciamo <b>prima</b> di iniziare</li>
          <li>Possiamo ricevervi <b>a negozio chiuso</b>, su appuntamento</li>
        </ul>
        <p class="rich-tel">Preferite parlarne a voce? <a href={'tel:' + INFO.telHref}>{INFO.tel}</a></p>
      </div>

      <form class="modulo a" id="perForm">
        <label>Di che tipo di valutazione avete bisogno
          <select id="q-tipo">
            <option>Successione</option>
            <option>Divisione tra eredi</option>
            <option>Apertura di cassetta di sicurezza</option>
            <option>Assicurazione</option>
            <option>Solo per sapere quanto vale</option>
          </select>
        </label>
        <div class="rich-riga">
          <label>Quanti pezzi, all’incirca
            <select id="q-pezzi">
              <option>1–3</option><option>4–10</option><option>11–30</option><option>Più di 30</option><option>Non lo so ancora</option>
            </select>
          </label>
          <label>Dove si trovano
            <select id="q-dove">
              <option>Li porto in negozio</option>
              <option>In una cassetta di sicurezza</option>
              <option>A casa, non si possono spostare</option>
            </select>
          </label>
        </div>
        <label>Il vostro nome<input type="text" id="q-nome" required autocomplete="name" /></label>
        <label>Telefono<input type="tel" id="q-tel" required autocomplete="tel" /></label>
        <label>Volete aggiungere qualcosa <small>(facoltativo)</small>
          <textarea id="q-note" rows="3" maxlength="500" placeholder="Es. sono gioielli di mia madre, vorrei capire come muovermi"></textarea>
        </label>
        <label class="consenso">
          <input type="checkbox" id="q-privacy" required />
          <span>Ho letto l’<a href="/demoMasGioielli/privacy/">informativa privacy</a> e acconsento al trattamento dei dati per essere ricontattato.</span>
        </label>
        <button type="submit" class="btn btn-pieno">Invia la richiesta</button>
        <p class="esito" id="perOk" role="status" aria-live="polite"></p>
        <p class="nota">Bozza dimostrativa: nella versione reale la richiesta arriva subito al negozio (email + WhatsApp), senza passare da nessun altro.</p>
      </form>
    </div>

    <div class="misura">
      <p class="promemoria">💡 <b>Per il titolare:</b> è il modulo che porta il lavoro più redditizio. Chi cerca «perizia gioielli successione Torino» oggi non vi trova: con questa pagina indicizzata, sì.</p>
    </div>
  </section>

  <style>
    .testa-pagina{padding-top:calc(var(--tastata) + clamp(2.5rem,6vw,4.5rem));padding-bottom:clamp(2.5rem,5vw,4rem)}

    /* riserbo: banda scura con una sola frase grande */
    .riserbo{text-align:center;padding:clamp(3.5rem,7vw,5.5rem) 0}
    .riserbo-occ{color:var(--oro-c)}
    .riserbo-t{font-family:var(--disp);font-size:clamp(1.9rem,4.4vw,3.2rem);line-height:1.15;color:var(--avorio);margin:1.4rem 0 1.2rem}
    .riserbo-oro{color:var(--oro-c)}
    .riserbo-d{max-width:56ch;margin-inline:auto}

    /* casi: due colonne a filetto */
    .casi{display:grid;grid-template-columns:1fr 1fr;gap:0 clamp(2rem,5vw,4.5rem);margin-top:clamp(2rem,4vw,3rem)}
    .caso{padding:clamp(1.4rem,2.6vw,2rem) 0;border-bottom:1px solid var(--filo)}
    .caso:nth-child(-n+2){border-top:1px solid var(--filo)}
    .caso h4{font-family:var(--disp);font-weight:400;font-size:clamp(1.5rem,2.6vw,1.95rem);line-height:1.2}
    .caso p{color:var(--grafite);font-size:.94rem;margin-top:.5rem}

    /* passi: numeri romani, tre colonne */
    .passi-banda{padding-top:0}
    .passi{list-style:none;display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(1.6rem,4vw,3.4rem);margin-top:clamp(2.2rem,4vw,3.2rem)}
    .passi>*{min-width:0}
    .passi li{border-top:1px solid var(--filo);padding-top:1.4rem}
    .passo-n{display:block;font-family:var(--disp);font-size:1.05rem;color:var(--oro);letter-spacing:.1em;margin-bottom:.7rem}
    .passi b{display:block;font-family:var(--disp);font-weight:400;font-size:clamp(1.4rem,2.4vw,1.8rem);line-height:1.2}
    .passi p{color:var(--grafite);font-size:.93rem;margin-top:.5rem}

    /* richiesta */
    .rich-in{display:grid;grid-template-columns:.95fr 1.05fr;gap:clamp(2.5rem,6vw,5rem);align-items:start}
    .rich-in>*{min-width:0}
    .rich-h2{font-size:clamp(2rem,4.2vw,3rem);margin:1.4rem 0 0}
    .rich-p{color:var(--grafite);margin:1.3rem 0 1.8rem;max-width:48ch}
    .rich-punti{list-style:none;display:grid;gap:0;margin-bottom:1.8rem}
    .rich-punti li{padding:.75rem 0;border-bottom:1px solid var(--filo);color:var(--grafite);font-size:.93rem}
    .rich-punti li:first-child{border-top:1px solid var(--filo)}
    .rich-punti b{color:var(--inchiostro);font-weight:500}
    .rich-tel{font-size:.93rem;color:var(--grafite)}
    .rich-tel a{color:var(--oro);border-bottom:1px solid var(--oro)}
    .rich-riga{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}
    .rich-riga>*{min-width:0}
    .modulo small{letter-spacing:0;text-transform:none;font-weight:400;color:var(--grigio)}

    @media (max-width:900px){
      .casi{grid-template-columns:1fr}
      .caso:nth-child(-n+2){border-top:0}
      .caso:first-child{border-top:1px solid var(--filo)}
      .passi{grid-template-columns:1fr}
      .rich-in{grid-template-columns:1fr}
      .rich-riga{grid-template-columns:1fr}
    }
  </style>

  <script>
    import { traccia } from './_shared.js';
    document.getElementById('perForm').addEventListener('submit', (e) => {
      e.preventDefault();
      traccia('richiesta-perizia');
      const v = (id) => document.getElementById(id).value.trim();
      const ok = document.getElementById('perOk');
      ok.innerHTML = `Richiesta registrata, <b>${v('q-nome') || 'grazie'}</b>. Vi richiamiamo allo <b>${v('q-tel')}</b>, di solito in giornata. <i>(demo: nessun dato è stato inviato)</i>`;
      ok.style.display = 'block';
      ok.scrollIntoView({ behavior: 'smooth', block: 'center' });
      e.target.reset();
    });
  </script>
</Layout>
