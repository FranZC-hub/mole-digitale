---
import Layout from './_Layout.astro';
import { INFO } from './_shared.js';
// Atelier: due strumenti che tolgono attrito prima ancora che il cliente entri —
// 1) preventivo guidato per le riparazioni  2) calibro per la misura dell'anello.
const lavori = [
  { n: '01', t: 'Creazioni su misura', d: 'Dal disegno al pezzo finito. Portateci un’idea, una foto o un gioiello di famiglia da reinterpretare.' },
  { n: '02', t: 'Trasformazioni', d: 'Un gioiello che non mettete più può tornare a vivere in un’altra forma, con le stesse pietre.' },
  { n: '03', t: 'Riparazioni', d: 'Saldature, cambio misura, rimonta di pietre, chiusure, catene spezzate, lucidature.' },
  { n: '04', t: 'Orologeria', d: 'Pile, cinturini, accorciatura bracciali, revisioni complete e prove di impermeabilità.' },
  { n: '05', t: 'Pendoleria', d: 'Orologi da tasca, sveglie e pendoli d’epoca: revisione della meccanica e restauro.' },
  { n: '06', t: 'Manutenzione', d: 'Pulizia a ultrasuoni, lucidatura e controllo delle griffe: il pezzo torna come nuovo.' },
];
---
<Layout title="Atelier" active="Atelier" desc={`Il laboratorio artigianale di ${INFO.nome} a Torino: creazioni su misura, riparazioni, trasformazioni, orologeria e pendoleria. Preventivo indicativo online.`}>

  <section class="testa-pagina">
    <div class="misura stretta intro centro a">
      <span class="occhiello centro">L’atelier</span>
      <h1>Qui il gioiello<br/><span class="it oro">nasce e rinasce</span></h1>
      <p>Il banco è dietro il negozio. Non mandiamo via niente: quello che si può salvare, lo salviamo noi — con le mani, come si è sempre fatto.</p>
    </div>
  </section>

  <section class="banda lavori-banda">
    <div class="misura">
      <h2 class="sr-only">Cosa facciamo in laboratorio</h2>
      <ul class="lavori">
        {lavori.map((l) => (
          <li class="a"><span class="lav-n">{l.n}</span><div><b>{l.t}</b><p>{l.d}</p></div></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PREVENTIVO GUIDATO -->
  <section class="scuro banda" id="preventivo">
    <div class="misura prev-in">
      <div class="a">
        <span class="occhiello">Preventivo in 30 secondi</span>
        <h2 class="prev-h2">Quanto costa<br/><span class="it prev-oro">aggiustarlo?</span></h2>
        <p class="prev-p">Tre domande e vi diamo una fascia di prezzo indicativa. Il preventivo esatto lo facciamo con il pezzo in mano — sempre gratis e senza impegno.</p>
        <form class="modulo modulo-scuro" id="prevForm">
          <label>Che cos’è
            <select id="p-oggetto">
              <option value="anello">Anello</option>
              <option value="collana">Collana o bracciale</option>
              <option value="orecchini">Orecchini</option>
              <option value="orologio">Orologio</option>
              <option value="pendolo">Orologio da tasca / pendolo</option>
            </select>
          </label>
          <label>Cosa serve
            <select id="p-intervento"></select>
          </label>
          <label>In che materiale
            <select id="p-materiale">
              <option value="oro">Oro</option>
              <option value="argento">Argento</option>
              <option value="acciaio">Acciaio</option>
              <option value="altro">Non lo so</option>
            </select>
          </label>
        </form>
      </div>

      <aside class="stima a" aria-live="polite">
        <span class="occhiello">Stima indicativa</span>
        <p class="stima-cifra" id="prevCifra">€ 30 – 60</p>
        <p class="stima-tempi" id="prevTempi">In genere pronto in 3–5 giorni.</p>
        <hr class="filo" />
        <p class="stima-nota">Portatelo in negozio: lo guardiamo insieme e vi confermiamo subito.</p>
        <a class="btn btn-chiaro btn-pieno" id="prevWa" href="#" target="_blank" rel="noopener">Manda la richiesta su WhatsApp</a>
        <p class="nota stima-note">Apriamo WhatsApp col messaggio già scritto: aggiungete una foto e vi rispondiamo.</p>
      </aside>
    </div>
  </section>

  <!-- CALIBRO MISURA ANELLO -->
  <section class="banda" id="misura">
    <div class="misura stretta intro centro a">
      <span class="occhiello centro">Strumento</span>
      <h2>Che misura<br/><span class="it oro">di anello portate?</span></h2>
      <p>È la domanda più frequente del negozio. Prendete un anello che già vi va bene, appoggiatelo allo schermo e fatelo combaciare con il cerchio.</p>
    </div>

    <div class="misura cal-wrap a">
      <div class="cal-passo">
        <p class="cal-n">Primo passo</p>
        <h3>Calibra lo schermo</h3>
        <p class="cal-d">Appoggiate una <b>tessera</b> (bancomat, carta d’identità) sul rettangolo e muovete il cursore finché combaciano.</p>
        <div class="cal-tessera" id="calCard" aria-hidden="true"></div>
        <label class="cal-range">Larghezza della tessera
          <input type="range" id="calRange" min="180" max="480" value="300" step="1" aria-describedby="calHint" />
        </label>
        <p class="nota" id="calHint">Una tessera standard è larga 85,6 mm. Serve solo la prima volta.</p>
      </div>

      <div class="cal-passo">
        <p class="cal-n">Secondo passo</p>
        <h3>Appoggia il tuo anello</h3>
        <p class="cal-d">Fate combaciare il <b>bordo interno</b> dell’anello con il cerchio.</p>
        <div class="cal-box"><div class="cal-cerchio" id="calRing"></div></div>
        <!-- valore in DECIMI di millimetro: 140 = 14,0 mm … 230 = 23,0 mm (misure reali) -->
        <label class="cal-range">Diametro interno
          <input type="range" id="ringRange" min="140" max="230" value="170" step="1" aria-describedby="ringOut" />
        </label>
        <p class="cal-esito" id="ringOut" aria-live="polite">Misura italiana <b>—</b></p>
        <a class="btn btn-vuoto btn-pieno" id="misuraWa" href="#" target="_blank" rel="noopener">Salva la misura e scrivici</a>
      </div>
    </div>

    <div class="misura">
      <p class="promemoria">💡 <b>Per il titolare:</b> è lo strumento che fa entrare la gente in negozio già decisa. Chi conosce la propria misura compra; chi non la sa, rimanda.</p>
    </div>
  </section>

  <style>
    .testa-pagina{padding-top:calc(var(--tastata) + clamp(2.5rem,6vw,4.5rem));padding-bottom:clamp(1rem,2vw,2rem)}

    /* elenco lavori: due colonne di voci a filetto, niente riquadri */
    .lavori-banda{padding-top:clamp(2rem,4vw,3rem)}
    .lavori{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:0 clamp(2rem,5vw,4.5rem)}
    .lavori li{display:grid;grid-template-columns:auto 1fr;gap:1.2rem;align-items:baseline;padding:clamp(1.3rem,2.6vw,1.9rem) 0;border-bottom:1px solid var(--filo)}
    .lavori li:nth-child(-n+2){border-top:1px solid var(--filo)}
    .lav-n{font-family:var(--disp);font-size:.95rem;color:var(--oro)}
    .lavori b{display:block;font-family:var(--disp);font-weight:400;font-size:clamp(1.4rem,2.4vw,1.85rem);line-height:1.2}
    .lavori p{color:var(--grafite);font-size:.93rem;margin-top:.3rem}

    /* preventivo su fondo scuro */
    .prev-in{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(2.5rem,6vw,5rem);align-items:start}
    .prev-in>*{min-width:0}
    .prev-h2{font-size:clamp(2rem,4.4vw,3.2rem);color:var(--avorio);margin:1.4rem 0 0}
    .prev-oro{color:var(--oro-c)}
    .prev-p{margin:1.3rem 0 2.2rem;max-width:46ch}
    .modulo-scuro label{color:#a79d90}
    .modulo-scuro select{color:var(--avorio);border-bottom-color:var(--filo-c)}
    .modulo-scuro select option{background:var(--scuro);color:var(--avorio)}
    .modulo-scuro select:focus{border-bottom-color:var(--oro-c)}

    .stima{border:1px solid var(--filo-c);padding:clamp(1.8rem,3.4vw,2.6rem);display:flex;flex-direction:column;gap:.5rem;text-align:center}
    .stima-cifra{font-family:var(--disp);font-size:clamp(2.8rem,6.4vw,4rem);line-height:1;color:var(--oro-c);margin-top:1rem}
    .stima-tempi{color:var(--avorio) !important;font-size:.95rem;margin-bottom:1.2rem}
    .stima .filo{width:100%;margin:.4rem 0 1.2rem}
    .stima-nota{font-size:.92rem;margin-bottom:1.4rem}
    .stima-note{color:#8f867c !important;margin-top:.9rem}

    /* calibro */
    .cal-wrap{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,4rem);margin-top:clamp(2.5rem,5vw,4rem)}
    .cal-wrap>*{min-width:0}
    .cal-passo{border-top:1px solid var(--filo);padding-top:1.6rem}
    .cal-n{font-size:.66rem;letter-spacing:.24em;text-transform:uppercase;color:var(--oro);margin-bottom:.6rem}
    .cal-passo h3{font-size:clamp(1.5rem,2.8vw,2rem)}
    .cal-d{color:var(--grafite);font-size:.94rem;margin:.5rem 0 1.8rem}
    .cal-tessera{height:54px;border:1px dashed var(--oro);background:rgba(133,107,55,.07);margin:0 auto 1.4rem;transition:width .1s linear}
    .cal-box{height:150px;display:grid;place-items:center;margin-bottom:1.4rem}
    .cal-cerchio{border:2px solid var(--oro);border-radius:50%;background:rgba(133,107,55,.06);transition:width .1s linear,height .1s linear}
    .cal-range{display:flex;flex-direction:column;gap:.5rem;font-size:.66rem;font-weight:500;letter-spacing:.2em;text-transform:uppercase;color:var(--grigio)}
    .cal-range input[type=range]{width:100%;accent-color:var(--oro)}
    .cal-esito{text-align:center;font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;color:var(--grigio);margin:1.6rem 0 1.4rem}
    /* :global — il contenuto è iniettato via JS e non riceve lo scope di Astro */
    .cal-esito :global(b){display:block;font-family:var(--disp);font-weight:400;font-size:3.4rem;line-height:1.05;color:var(--oro);letter-spacing:0;margin:.3rem 0}
    .cal-esito :global(.nota){display:block;letter-spacing:0;text-transform:none}

    @media (max-width:900px){
      .lavori{grid-template-columns:1fr}
      .lavori li:nth-child(-n+2){border-top:0}
      .lavori li:first-child{border-top:1px solid var(--filo)}
      .prev-in,.cal-wrap{grid-template-columns:1fr}
    }
  </style>

  <script>
    import { INFO } from './_shared.js';
    const $ = (s) => document.querySelector(s);
    const WA = (t) => `https://wa.me/${INFO.wa}?text=${encodeURIComponent(t)}`;

    /* ---------------- preventivo guidato ---------------- */
    // Fasce indicative: [min, max] in euro + tempi tipici.
    const INTERVENTI = {
      anello:    [['misura', 'Cambio misura', [25, 45], '2–4 giorni'], ['saldatura', 'Saldatura', [20, 40], '2–4 giorni'], ['pietra', 'Rimonta di una pietra', [35, 90], '4–7 giorni'], ['lucidatura', 'Lucidatura e pulizia', [15, 30], '1–2 giorni']],
      collana:   [['catena', 'Catena spezzata', [20, 40], '2–4 giorni'], ['chiusura', 'Sostituzione chiusura', [25, 55], '2–5 giorni'], ['accorcia', 'Accorciare o allungare', [25, 60], '3–5 giorni'], ['lucidatura', 'Lucidatura e pulizia', [15, 30], '1–2 giorni']],
      orecchini: [['perno', 'Perno o farfallina', [15, 35], '2–3 giorni'], ['chiusura', 'Chiusura a monachella', [25, 50], '3–5 giorni'], ['pietra', 'Rimonta di una pietra', [35, 90], '4–7 giorni']],
      orologio:  [['pila', 'Cambio pila', [10, 18], 'in giornata'], ['cinturino', 'Cinturino o bracciale', [25, 80], 'in giornata'], ['maglie', 'Accorciare il bracciale', [10, 20], 'in giornata'], ['revisione', 'Revisione completa', [90, 260], '2–4 settimane'], ['vetro', 'Sostituzione vetro', [45, 130], '1–2 settimane']],
      pendolo:   [['revisione', 'Revisione della meccanica', [120, 320], '3–6 settimane'], ['restauro', 'Restauro conservativo', [180, 500], '4–8 settimane'], ['quadrante', 'Pulizia quadrante e cassa', [60, 150], '2–3 settimane']],
    };
    const MAT = { oro: 1.15, argento: 1, acciaio: 1, altro: 1 };  // sull'oro il lavoro è più delicato

    const selOgg = $('#p-oggetto'), selInt = $('#p-intervento'), selMat = $('#p-materiale');
    const popola = () => { selInt.innerHTML = INTERVENTI[selOgg.value].map(([v, l]) => `<option value="${v}">${l}</option>`).join(''); };
    const calcola = () => {
      const voce = INTERVENTI[selOgg.value].find(([v]) => v === selInt.value) || INTERVENTI[selOgg.value][0];
      const [, label, [min, max], tempi] = voce;
      const k = MAT[selMat.value] ?? 1;
      const a = Math.round((min * k) / 5) * 5, b = Math.round((max * k) / 5) * 5;
      $('#prevCifra').textContent = `€ ${a} – ${b}`;
      $('#prevTempi').textContent = tempi === 'in giornata' ? 'Di solito si fa in giornata.' : `In genere pronto in ${tempi}.`;
      const ogg = selOgg.options[selOgg.selectedIndex].text;
      $('#prevWa').href = WA(`Buongiorno ${INFO.nome}! 👋\nAvrei bisogno di un lavoro in laboratorio:\n\n• Oggetto: ${ogg}\n• Intervento: ${label}\n• Materiale: ${selMat.options[selMat.selectedIndex].text}\n\n(Stima vista sul sito: € ${a}–${b}) Vi mando una foto. Grazie!`);
    };
    selOgg.addEventListener('change', () => { popola(); calcola(); });
    selInt.addEventListener('change', calcola);
    selMat.addEventListener('change', calcola);
    popola(); calcola();

    /* ---------------- calibro misura anello ----------------
       Lo schermo si calibra con una tessera standard (85,6 mm): da lì ricavo quanti
       pixel vale un millimetro. Lo slider è in DECIMI di mm (misura reale dell'anello),
       i pixel a schermo si ricavano dalla calibrazione. Misura italiana = circonferenza − 40. */
    const CARD_MM = 85.6, LS = 'mas-calibra';
    const calRange = $('#calRange'), calCard = $('#calCard');
    const ringRange = $('#ringRange'), calRing = $('#calRing'), ringOut = $('#ringOut');
    const pxPerMm = () => +calRange.value / CARD_MM;

    const aggiornaCard = () => { calCard.style.width = calRange.value + 'px'; try { localStorage.setItem(LS, calRange.value); } catch {} };
    const aggiornaAnello = () => {
      const mm = +ringRange.value / 10;
      const px = mm * pxPerMm();
      calRing.style.width = px + 'px'; calRing.style.height = px + 'px';
      const circ = Math.PI * mm;
      const misura = Math.round(circ - 40);
      ringOut.innerHTML = `Misura italiana <b>${misura > 0 ? misura : '—'}</b><span class="nota">diametro ${mm.toFixed(1)} mm · circonferenza ${circ.toFixed(1)} mm</span>`;
      $('#misuraWa').href = WA(`Buongiorno ${INFO.nome}! 👋\nHo misurato il mio anello sul vostro sito: risulta misura ${misura} (diametro interno ${mm.toFixed(1)} mm).\nVorrei una conferma in negozio. Grazie!`);
    };
    calRange.addEventListener('input', () => { aggiornaCard(); aggiornaAnello(); });
    ringRange.addEventListener('input', aggiornaAnello);
    try { const s = localStorage.getItem(LS); if (s) calRange.value = s; } catch {}
    aggiornaCard(); aggiornaAnello();
  </script>
</Layout>
