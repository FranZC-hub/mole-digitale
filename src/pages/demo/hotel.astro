    .hlinks{display:flex;gap:1.6rem}
    .hlinks a{font-size:.9rem;letter-spacing:.03em;color:#cfdbd4;position:relative;transition:color .25s}
    .hlinks a::after{content:'';position:absolute;left:0;bottom:-5px;height:1px;width:0;background:var(--ottone-c);transition:width .3s var(--e)}
    .hlinks a:hover{color:var(--panna)} .hlinks a:hover::after{width:100%}
    .hlinks .solo-mobile{display:none}
    .hnav-dx{display:flex;align-items:center;gap:.8rem}
    .lingua{display:flex;border:1px solid var(--filo-c);border-radius:999px;overflow:hidden}
    .lng{background:none;border:0;padding:.35rem .7rem;font-size:.76rem;letter-spacing:.1em;color:#cfdbd4;cursor:pointer;transition:.2s}
    .lng:hover{color:var(--panna)}
    .lng.on{background:var(--ottone-c);color:#14241d;font-weight:600}
    .hnav-toggle{display:none;background:none;border:0;cursor:pointer;width:42px;height:42px;border-radius:10px;place-items:center;color:inherit}

    .hbtn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:.75rem 1.5rem;border:0;cursor:pointer;
      font-size:.88rem;letter-spacing:.05em;text-transform:uppercase;font-weight:500;transition:transform .25s var(--e),background .25s,color .25s;white-space:nowrap}
    .hbtn-oro{background:var(--ottone-c);color:#14241d}
    .hbtn-oro:hover{transform:translateY(-2px);background:#e5cd93}
    .hbtn-filo{border:1px solid var(--filo);color:var(--inchiostro)}
    .hbtn-filo:hover{background:rgba(19,32,25,.05);transform:translateY(-2px)}
    .hbtn-wa{background:#25d366;color:#0b3d1c}
    .hbtn-wa:hover{transform:translateY(-2px);background:#20bd5b}

    /* HERO */
    .hero{background:var(--bosco);color:var(--panna);padding:calc(31px + 8rem) 0 clamp(3rem,7vw,5rem);position:relative;overflow:hidden}
    .hero::before{content:'';position:absolute;inset:0;background:
      radial-gradient(60% 50% at 78% 18%,rgba(216,189,122,.13),transparent 70%),
      radial-gradient(50% 40% at 10% 90%,rgba(216,189,122,.07),transparent 70%)}
    .hero-in{position:relative;max-width:1140px;margin:0 auto;padding-inline:clamp(1.2rem,5vw,3rem)}
    .occhiello{font-size:.74rem;letter-spacing:.24em;text-transform:uppercase;color:var(--ottone-c);margin-bottom:1.3rem}
    .hero-t{font-size:clamp(2.9rem,8vw,5.8rem);margin-bottom:1.3rem}
    .hero-t .it{color:var(--ottone-c)}
    .hero-s{font-size:1.1rem;color:var(--muted-c);max-width:52ch;margin-bottom:2.4rem}

    /* MOTORE */
    .motore{background:rgba(246,242,234,.06);border:1px solid var(--filo-c);padding:1.2rem;backdrop-filter:blur(6px)}
    .mot-campi{display:grid;grid-template-columns:1.2fr 1.2fr .7fr 1.5fr auto;gap:.8rem;align-items:end}
    .mot-campi>*{min-width:0}
    .mot-campi label{display:grid;gap:.35rem;font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ottone-c)}
    .mot-campi input,.mot-campi select{background:rgba(9,20,16,.5);border:1px solid var(--filo-c);color:var(--panna);
      padding:.7rem .8rem;font-size:.95rem;letter-spacing:0;text-transform:none;width:100%;border-radius:0}
    .mot-campi input::-webkit-calendar-picker-indicator{filter:invert(1) opacity(.6);cursor:pointer}
    .mot-btn{height:44px}
    .mot-err{margin-top:.8rem;color:#ffbfa8;font-size:.88rem}

    /* ESITO */
    .esito{background:var(--carta);color:var(--inchiostro);margin-top:1.2rem;padding:clamp(1.3rem,3vw,1.8rem)}
    .es-testa{display:flex;align-items:flex-start;justify-content:space-between;gap:1.5rem;flex-wrap:wrap;
      border-bottom:1px solid var(--filo);padding-bottom:1rem}
    .es-et{font-size:.68rem;letter-spacing:.2em;text-transform:uppercase;color:var(--ottone)}
    .es-riga{font-family:var(--disp);font-size:clamp(1.3rem,2.6vw,1.8rem);line-height:1.2;margin-top:.2rem}
    .es-prezzo{text-align:right}
    .es-prezzo b{display:block;font-family:var(--disp);font-size:clamp(2rem,4vw,2.8rem);line-height:1;font-variant-numeric:tabular-nums}
    .es-prezzo span{font-size:.82rem;color:var(--grigio)}
    .es-voci{list-style:none;display:grid;gap:.45rem;padding:1rem 0}
    .es-voci li{display:flex;justify-content:space-between;gap:1rem;font-size:.92rem;color:var(--grigio)}
    .es-voci li b{color:var(--inchiostro);font-variant-numeric:tabular-nums;white-space:nowrap}
    .es-conf{display:flex;align-items:center;justify-content:space-between;gap:1.2rem;flex-wrap:wrap;
      background:rgba(131,102,24,.10);padding:.9rem 1.1rem;margin-bottom:1.2rem}
    .es-conf-et{font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ottone)}
    .es-conf-p{font-size:.92rem;color:var(--grigio);margin-top:.15rem}
    .es-risp{font-family:var(--disp);font-size:1.5rem;color:var(--ottone);white-space:nowrap}
    .es-azioni{display:flex;gap:.7rem;flex-wrap:wrap}
    .es-nota{font-size:.78rem;color:var(--grigio);margin-top:1rem}

    /* BANDA ORO */
    .banda-oro{background:var(--ottone-c);color:#14241d}
    .oro-in{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;padding-block:clamp(1.6rem,3vw,2.2rem)}
    .oro-in>*{min-width:0}
    .oro-p b{display:block;font-family:var(--disp);font-size:1.35rem;font-weight:600}
    .oro-p span{font-size:.9rem;opacity:.82}

    /* SEZIONI */
    .sez{padding-block:clamp(3.5rem,8vw,6rem)}
    .sez-chiara{background:var(--carta)}
    .testa{max-width:680px;margin-bottom:clamp(2rem,4vw,3rem)}
    .kicker{display:inline-block;font-size:.7rem;letter-spacing:.22em;text-transform:uppercase;color:var(--ottone);margin-bottom:.8rem}
    .testa h2{font-size:clamp(2rem,5vw,3.2rem)}
    .lead{color:var(--grigio);margin-top:.9rem}
    .h3{font-family:var(--sans);font-size:.7rem;letter-spacing:.22em;text-transform:uppercase;color:var(--ottone);font-weight:600;margin-bottom:1rem}

    /* CAMERE */
    .camere{display:grid;grid-template-columns:1fr 1fr;gap:0 clamp(2rem,5vw,4rem)}
    .camere>*{min-width:0}
    .camera{padding:clamp(1.4rem,2.6vw,1.9rem) 0;border-bottom:1px solid var(--filo)}
    .camera:nth-child(-n+2){border-top:1px solid var(--filo)}
    .cam-testa{display:flex;align-items:baseline;justify-content:space-between;gap:1rem}
    .cam-testa h3{font-size:clamp(1.5rem,2.8vw,2rem)}
    .cam-da{font-size:.85rem;color:var(--grigio);white-space:nowrap}
    .cam-da b{font-family:var(--disp);font-size:1.5rem;color:var(--ottone)}
    .cam-d{color:var(--grigio);font-size:.95rem;margin-top:.5rem}
    .cam-dati{list-style:none;display:flex;gap:1.8rem;flex-wrap:wrap;margin:1.1rem 0}
    .cam-dati span{display:block;font-size:.66rem;letter-spacing:.16em;text-transform:uppercase;color:var(--grigio)}
    .cam-dati b{font-weight:500;font-size:.95rem}
    .cam-btn{background:none;border:0;border-bottom:1px solid var(--ottone);color:var(--ottone);padding:0 0 .2rem;
      cursor:pointer;font-size:.88rem;transition:.25s var(--e)}
    .cam-btn:hover{color:var(--inchiostro);border-color:var(--inchiostro)}

    /* SERVIZI */
    .serv{display:grid;grid-template-columns:repeat(3,1fr);gap:0 clamp(2rem,4vw,3.5rem)}
    .serv>*{min-width:0}
    .serv-c{padding:1.2rem 0;border-bottom:1px solid var(--filo)}
    .serv-c:nth-child(-n+3){border-top:1px solid var(--filo)}
    .serv-c b{display:block;font-family:var(--disp);font-size:1.3rem;font-weight:600}
    .serv-c span{color:var(--grigio);font-size:.92rem}

    /* DOVE */
    .dove-in{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(2rem,5vw,4rem);align-items:start}
    .dove-in>*{min-width:0}
    .dove-h{font-size:clamp(1.9rem,4vw,2.8rem);margin:.4rem 0 0}
    .dove-p{color:var(--grigio);margin:1rem 0 1.6rem;max-width:46ch}
    .dove-azioni{display:flex;gap:.7rem;flex-wrap:wrap}
    .vicino{list-style:none}
    .vicino li{display:grid;grid-template-columns:1fr auto auto;gap:1rem;align-items:baseline;
      padding:.7rem 0;border-bottom:1px solid var(--filo);font-size:.95rem}
    .vicino li:first-child{border-top:1px solid var(--filo)}
    .vicino b{font-family:var(--disp);font-size:1.15rem;color:var(--ottone);font-variant-numeric:tabular-nums}
    .vicino i{font-style:normal;font-size:.82rem;color:var(--grigio);min-width:8.5rem;text-align:right}

    /* RECENSIONI */
    .banda-scura{background:var(--bosco);color:var(--panna);padding-block:clamp(3rem,6vw,4.5rem)}
    .rece{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(1.5rem,4vw,3rem)}
    .rece>*{min-width:0}
    .rec blockquote{font-family:var(--disp);font-size:1.25rem;line-height:1.4;font-style:italic}
    .rec blockquote::before{content:'«';color:var(--ottone-c)}
    .rec blockquote::after{content:'»';color:var(--ottone-c)}
    .rec figcaption{margin-top:.7rem;font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ottone-c)}

    /* DOMANDE */
    .faq{display:grid}
    .dom{border-bottom:1px solid var(--filo)}
    .dom:first-child{border-top:1px solid var(--filo)}
    .dom summary{cursor:pointer;list-style:none;padding:1.1rem 2rem 1.1rem 0;position:relative;
      font-family:var(--disp);font-size:1.3rem;font-weight:600}
    .dom summary::-webkit-details-marker{display:none}
    .dom summary::after{content:'+';position:absolute;right:.2rem;top:50%;transform:translateY(-50%);
      color:var(--ottone);font-family:var(--sans);font-size:1.3rem;transition:transform .3s var(--e)}
    .dom[open] summary::after{content:'−'}
    .dom summary:hover{color:var(--ottone)}
    .dom p{color:var(--grigio);font-size:.95rem;padding-bottom:1.2rem;max-width:66ch}

    .hfoot{background:var(--bosco);color:var(--muted-c);padding-block:1.6rem;border-top:1px solid var(--filo-c)}
    .hfoot-in{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;font-size:.85rem}
    .hfoot a{color:var(--ottone-c)}

    /* Reveal */
    /* Lo stato nascosto vale solo se il JavaScript c'è: senza, il contenuto
       resterebbe invisibile per sempre invece di limitarsi a non animarsi. */
    @media (scripting: enabled){
      .r{opacity:0;transform:translateY(18px)}
    }
    .r.in{opacity:1;transform:none;transition:opacity .7s var(--e),transform .7s var(--e)}

    @media (max-width:1000px){
      .mot-campi{grid-template-columns:1fr 1fr;}
      .mot-btn{grid-column:1/-1;height:46px}
      .serv{grid-template-columns:1fr 1fr}
      .serv-c:nth-child(-n+3){border-top:0}
      .serv-c:nth-child(-n+2){border-top:1px solid var(--filo)}
      .rece{grid-template-columns:1fr;gap:1.8rem}
    }
    @media (max-width:900px){
      .hlinks{display:none}
      .hnav-toggle{display:grid}
      .hnav.aperta{background:rgba(15,36,29,.97);backdrop-filter:blur(14px)}
      .hnav.aperta .hlinks{display:flex;position:absolute;top:100%;left:0;right:0;flex-direction:column;gap:1.1rem;
        background:rgba(15,36,29,.98);border-bottom:1px solid var(--filo-c);padding:1.2rem clamp(1.2rem,5vw,3rem) 1.5rem}
      .camere,.dove-in{grid-template-columns:1fr}
      .camera:nth-child(-n+2){border-top:0}
      .camera:first-child{border-top:1px solid var(--filo)}
      .oro-in{grid-template-columns:1fr;gap:1.1rem}
      .hbrand-t{font-size:1.15rem}
      .hnav-dx .hbtn{padding:.55rem 1rem;font-size:.78rem}
    }
    @media (max-width:560px){
      /* marchio + lingua + hamburger + CTA non ci stanno: il "Prenota" passa nel menu */
      .hnav-dx>.hbtn{display:none}
      .hlinks .solo-mobile{display:block}
      .hbrand-t{font-size:1.05rem}
      .serv{grid-template-columns:1fr}
      .serv-c:nth-child(-n+2){border-top:0}
      .serv-c:first-child{border-top:1px solid var(--filo)}
      .vicino li{grid-template-columns:1fr auto}
      .vicino i{grid-column:1/-1;text-align:left;min-width:0}
      .es-prezzo{text-align:left}
    }
    @media (prefers-reduced-motion:reduce){ .r{opacity:1 !important;transform:none !important} }
  </style>

  <script>
    // ---------- dati ----------
    const CAMERE = {
      singola:      { base: 79,  n: 'Singola',                 en: 'Single',                    max: 1 },
      matrimoniale: { base: 99,  n: 'Matrimoniale',            en: 'Double',                    max: 2 },
      superior:     { base: 129, n: 'Superior con vista Mole',  en: 'Superior with Mole view',  max: 3 },
      suite:        { base: 179, n: 'Suite dei Palchi',         en: 'Palchi Suite',             max: 4 },
    };
    // Torino: alta stagione in primavera, a settembre-ottobre e sotto Natale. Agosto è morto.
    const STAGIONE = [0.85, 0.85, 1, 1.15, 1.15, 1.1, 0.9, 0.8, 1.15, 1.15, 1, 1.05];
    const TASSA = 3.00;         // € a persona a notte
    const TASSA_MAX_NOTTI = 7;
    const COMMISSIONE = 0.18;   // quanto trattiene il portale

    const T = {
      it: {
        soggiorno: 'Il vostro soggiorno', notti: (n) => n === 1 ? '1 notte' : `${n} notti`,
        camera: 'Camera', tassa: 'Tassa di soggiorno', tassaD: (p, n) => `${p} × ${n} × 3,00 €`,
        colazione: 'Colazione per tutti', inclusa: 'inclusa',
        portale: 'La stessa camera, su un portale',
        portaleP: 'Stesso letto, stessa colazione, prezzo più alto: la differenza è la commissione.',
        portaleC: (p, d) => `${p} invece di ${d}. Stesso letto, stessa colazione: la differenza se la prende il portale.`,
        risparmio: (v) => `risparmiate ${v} €`,
        errDate: 'Serve una data di arrivo e una di partenza.',
        errOrdine: 'La partenza deve venire dopo l’arrivo.',
        errPassato: 'La data di arrivo è già passata.',
        errLunga: 'Per soggiorni oltre 30 notti chiamateci: vi facciamo un prezzo dedicato.',
        errOspiti: (n, c) => `In ${c} ci stanno al massimo ${n} ospiti. Provate un’altra camera.`,
        nota: 'Demo: nessuna prenotazione viene registrata. Sul sito vero la richiesta arriva in reception e la disponibilità è quella reale del gestionale.',
        wa: (r) => `Buongiorno! Vorrei prenotare all'Albergo del Teatro:\n${r}\n\n(richiesta inviata dal sito)`,
        dal: 'dal', al: 'al', per: 'per', ospiti: (n) => n === 1 ? '1 ospite' : `${n} ospiti`,
      },
      en: {
        soggiorno: 'Your stay', notti: (n) => n === 1 ? '1 night' : `${n} nights`,
        camera: 'Room', tassa: 'City tax', tassaD: (p, n) => `${p} × ${n} × €3.00`,
        colazione: 'Breakfast for everyone', inclusa: 'included',
        portale: 'The same room, on a booking portal',
        portaleP: 'Same bed, same breakfast, higher price: the difference is the commission.',
        portaleC: (p, d) => `${p} instead of ${d}. Same bed, same breakfast: the difference goes to the portal.`,
        risparmio: (v) => `you save €${v}`,
        errDate: 'We need an arrival and a departure date.',
        errOrdine: 'Departure must come after arrival.',
        errPassato: 'The arrival date is in the past.',
        errLunga: 'For stays longer than 30 nights please call us: we will quote a dedicated rate.',
        errOspiti: (n, c) => `The ${c} sleeps ${n} guests at most. Please try another room.`,
        nota: 'Demo: no booking is actually recorded. On the real site the request reaches reception and availability comes from the hotel system.',
        wa: (r) => `Hello! I would like to book at Albergo del Teatro:\n${r}\n\n(request sent from the website)`,
        dal: 'from', al: 'to', per: 'for', ospiti: (n) => n === 1 ? '1 guest' : `${n} guests`,
      },
    };

    let lng = 'it';
    const euro = (n) => n.toFixed(2).replace('.', ',');
    const money = (n) => lng === 'en' ? '€' + n.toFixed(2) : euro(n) + ' €';

    // ---------- lingua ----------
    function applica(l) {
      lng = l;
      document.documentElement.lang = l;
      document.querySelectorAll('[data-en]').forEach((el) => {
        if (el.dataset.it === undefined) el.dataset.it = el.textContent;
        el.textContent = l === 'en' ? el.dataset.en : el.dataset.it;
      });
      document.querySelectorAll('.lng').forEach((b) => {
        const on = b.dataset.lng === l;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', String(on));
      });
      document.getElementById('esEt').textContent = T[l].soggiorno;
      document.getElementById('esConfEt').textContent = T[l].portale;
      document.getElementById('esConfP').textContent = T[l].portaleP;
      document.getElementById('esNota').textContent = T[l].nota;
      if (!document.getElementById('esito').hidden) calcola(true);
      try { localStorage.setItem('teatro-lng', l); } catch (_) {}
    }
    document.querySelectorAll('.lng').forEach((b) => b.addEventListener('click', () => applica(b.dataset.lng)));

    // ---------- nav ----------
    const hnav = document.getElementById('hnav');
    addEventListener('scroll', () => hnav.classList.toggle('solid', scrollY > 30), { passive: true });
    const toggle = document.getElementById('navToggle');
    toggle.addEventListener('click', () => {
      const o = hnav.classList.toggle('aperta');
      toggle.setAttribute('aria-expanded', String(o));
    });
    document.querySelectorAll('.hlinks a').forEach((a) => a.addEventListener('click', () => {
      hnav.classList.remove('aperta'); toggle.setAttribute('aria-expanded', 'false');
    }));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && hnav.classList.contains('aperta')) { hnav.classList.remove('aperta'); toggle.setAttribute('aria-expanded', 'false'); }
    });

    // ---------- date ----------
    const iso = (d) => d.toISOString().slice(0, 10);
    const oggi = new Date(); oggi.setHours(12, 0, 0, 0);
    const dataIn = document.getElementById('dataIn');
    const dataOut = document.getElementById('dataOut');
    const piu = (d, n) => { const x = new Date(d); x.setDate(x.getDate() + n); return x; };
    dataIn.min = iso(oggi);
    dataOut.min = iso(piu(oggi, 1));
    dataIn.value = iso(piu(oggi, 7));
    dataOut.value = iso(piu(oggi, 9));
    dataIn.addEventListener('change', () => {
      const i = new Date(dataIn.value);
      if (!isNaN(i)) {
        dataOut.min = iso(piu(i, 1));
        if (new Date(dataOut.value) <= i) dataOut.value = iso(piu(i, 2));
      }
    });

    // ---------- preventivo ----------
    const err = document.getElementById('motErr');
    const esito = document.getElementById('esito');
    const dataLunga = (d) => d.toLocaleDateString(lng === 'en' ? 'en-GB' : 'it-IT', { day: 'numeric', month: 'long' });

    function calcola(silenzioso) {
      const a = new Date(dataIn.value), b = new Date(dataOut.value);
      const ospiti = +document.getElementById('ospiti').value;
      const k = document.getElementById('tipo').value;
      const cam = CAMERE[k];
      const nome = lng === 'en' ? cam.en : cam.n;
      const mostra = (m) => { err.textContent = m; err.hidden = false; esito.hidden = true; };

      if (isNaN(a) || isNaN(b)) return mostra(T[lng].errDate);
      const zero = new Date(); zero.setHours(0, 0, 0, 0);
      if (a < zero) return mostra(T[lng].errPassato);
      const notti = Math.round((b - a) / 86400000);
      if (notti < 1) return mostra(T[lng].errOrdine);
      if (notti > 30) return mostra(T[lng].errLunga);
      if (ospiti > cam.max) return mostra(T[lng].errOspiti(cam.max, nome));
      err.hidden = true;

      // notte per notte: la tariffa segue la stagione del giorno
      let camere = 0;
      for (let i = 0; i < notti; i++) {
        const g = piu(a, i);
        camere += cam.base * STAGIONE[g.getMonth()];
      }
      camere = Math.round(camere);
      const tassa = TASSA * ospiti * Math.min(notti, TASSA_MAX_NOTTI);
      const totale = camere + tassa;
      const portale = Math.round(camere / (1 - COMMISSIONE));
      const risparmio = portale - camere;

      document.getElementById('esRiga').textContent =
        `${nome} · ${T[lng].dal} ${dataLunga(a)} ${T[lng].al} ${dataLunga(b)}`;
      document.getElementById('esTot').textContent = money(totale);
      document.getElementById('esNotti').textContent = `${T[lng].notti(notti)} · ${T[lng].ospiti(ospiti)}`;
      document.getElementById('esVoci').innerHTML =
        `<li><span>${T[lng].camera} — ${T[lng].notti(notti)}</span><b>${money(camere)}</b></li>` +
        `<li><span>${T[lng].colazione}</span><b>${T[lng].inclusa}</b></li>` +
        `<li><span>${T[lng].tassa} — ${T[lng].tassaD(ospiti, Math.min(notti, TASSA_MAX_NOTTI))}</span><b>${money(tassa)}</b></li>`;
      document.getElementById('esRisp').textContent = T[lng].risparmio(risparmio);
      document.getElementById('esConfP').textContent = T[lng].portaleC(money(portale), money(camere));

      const righe = `${nome}\n${dataLunga(a)} → ${dataLunga(b)} (${T[lng].notti(notti)})\n${T[lng].ospiti(ospiti)}\n${T[lng].camera}: ${money(camere)} + ${T[lng].tassa} ${money(tassa)}`;
      document.getElementById('esWa').href = 'https://wa.me/390110000000?text=' + encodeURIComponent(T[lng].wa(righe));

      esito.hidden = false;
      esito.classList.add('in');
      if (!silenzioso) esito.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
    document.getElementById('calcola').addEventListener('click', () => calcola(false));

    // dalle camere si torna al motore con il tipo già scelto
    document.querySelectorAll('[data-scegli]').forEach((b) => b.addEventListener('click', () => {
      document.getElementById('tipo').value = b.dataset.scegli;
      const max = CAMERE[b.dataset.scegli].max;
      const sel = document.getElementById('ospiti');
      if (+sel.value > max) sel.value = String(max);
      document.getElementById('prenota').scrollIntoView({ behavior: 'smooth', block: 'center' });
      calcola(true);
    }));

    // ---------- reveal ----------
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('.r').forEach((el) => el.classList.add('in'));
    } else {
      const io = new IntersectionObserver((es) => es.forEach((en) => {
        if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
      }), { threshold: 0.12, rootMargin: '0px 0px -40px' });
      document.querySelectorAll('.r').forEach((el) => io.observe(el));
    }

    // ---------- avvio ----------
    let salvata = null;
    try { salvata = localStorage.getItem('teatro-lng'); } catch (_) {}
    applica(salvata === 'en' || (!salvata && !navigator.language.startsWith('it')) ? 'en' : 'it');

    // Statistiche first-party (nessun cookie, niente IP): conta la visita alla demo
    try { if (!navigator.webdriver && !["localhost","127.0.0.1"].includes(location.hostname)) {
      let sref = ""; try { const u = new URL(document.referrer); if (u.host !== location.host) sref = u.host; } catch (_) {}
      fetch("/stats.php?p=" + encodeURIComponent(location.pathname) + "&r=" + encodeURIComponent(sref), { keepalive: true }).catch(() => {});
    } } catch (_) {}
  </script>
</body>
</html>
