---
// DEMO standalone — "Albergo del Teatro", boutique hotel a Torino. Tema verde bosco + ottone.
// Sito a sé (non usa il Layout di Mole Digitale). JS vanilla, nessuna libreria.
//
// Il lavoro di un sito d'albergo è UNO: far prenotare DIRETTO invece che sulle OTA,
// dove se ne va il 15–18% di commissione. Quindi il motore di preventivo sta in cima,
// e accanto al prezzo c'è sempre quanto costerebbe la stessa camera su Booking.
// Seconda cosa che nessun sito d'albergo italiano fa bene: l'inglese. C'è il cambio lingua.
import '@fontsource-variable/cormorant';
import '@fontsource-variable/jost';
// Precarico i woff2: senza, il testo si disegna col ripiego e al cambio font
// l'hero si riassesta — cioè spostamenti di layout (CLS) sul primo schermo.
import cormorantWoff2 from '@fontsource-variable/cormorant/files/cormorant-latin-wght-normal.woff2?url';
import jostWoff2 from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';

const CAMERE = [
  { k: 'singola', n: 'Singola', en: 'Single', mq: 14, letti: '1 letto singolo', lettiEn: '1 single bed', max: 1, base: 79,
    d: 'Piccola e ordinata, affacciata sulla corte interna: si dorme in silenzio anche in centro.',
    dEn: 'Small and tidy, facing the inner courtyard: quiet sleep even in the city centre.' },
  { k: 'matrimoniale', n: 'Matrimoniale', en: 'Double', mq: 20, letti: '1 letto matrimoniale', lettiEn: '1 double bed', max: 2, base: 99,
    d: 'La camera di sempre: soffitti alti, parquet originale e un bagno rifatto l’anno scorso.',
    dEn: 'Our classic room: high ceilings, original parquet and a bathroom renovated last year.' },
  { k: 'superior', n: 'Superior con vista Mole', en: 'Superior with Mole view', mq: 26, letti: '1 matrimoniale + divano letto', lettiEn: '1 double + sofa bed', max: 3, base: 129,
    d: 'Il terzo piano, la finestra grande e la Mole che si accende alle nove di sera.',
    dEn: 'Third floor, a large window and the Mole lighting up at nine in the evening.' },
  { k: 'suite', n: 'Suite dei Palchi', en: 'Palchi Suite', mq: 38, letti: '1 matrimoniale + zona giorno', lettiEn: '1 double + living area', max: 4, base: 179,
    d: 'Due stanze comunicanti, vasca separata e la scrivania buona per chi resta a lavorare.',
    dEn: 'Two connecting rooms, separate bathtub and a proper desk for those who stay to work.' },
];

const SERVIZI = [
  { t: 'Colazione inclusa', tEn: 'Breakfast included', d: 'Dalle 7 alle 10:30, servita al tavolo. Torte fatte in casa, uova su richiesta.', dEn: 'From 7 to 10:30, served at the table. Homemade cakes, eggs on request.' },
  { t: 'Wi‑Fi in tutto il palazzo', tEn: 'Wi‑Fi throughout', d: 'Fibra vera, anche nelle camere in fondo al corridoio. Nessuna registrazione.', dEn: 'Real fibre, even in the rooms at the end of the hall. No sign-up.' },
  { t: 'Parcheggio convenzionato', tEn: 'Partner car park', d: '18 € al giorno nell’autorimessa a 80 metri: ve lo prenotiamo noi.', dEn: '€18 a day in the garage 80 metres away: we book it for you.' },
  { t: 'Check‑in 14:00 · check‑out 11:00', tEn: 'Check-in 2 pm · check-out 11 am', d: 'Arrivate prima o partite tardi? Il bagaglio resta qui, senza costi.', dEn: 'Arriving early or leaving late? We keep your luggage, free of charge.' },
  { t: 'Animali benvenuti', tEn: 'Pets welcome', d: 'Fino a 10 kg, senza supplemento. La ciotola ve la diamo noi.', dEn: 'Up to 10 kg, no surcharge. We provide the bowl.' },
  { t: 'Ascensore e camera accessibile', tEn: 'Lift and accessible room', d: 'Ascensore a tutti i piani e una camera al primo piano senza barriere.', dEn: 'Lift to all floors and a step-free room on the first floor.' },
];

const VICINO = [
  { l: 'Mole Antonelliana', m: '200 m', p: '3 min a piedi', pEn: '3 min walk' },
  { l: 'Museo Egizio', m: '700 m', p: '9 min a piedi', pEn: '9 min walk' },
  { l: 'Piazza San Carlo', m: '650 m', p: '8 min a piedi', pEn: '8 min walk' },
  { l: 'Stazione di Porta Nuova', m: '900 m', p: '12 min a piedi', pEn: '12 min walk' },
  { l: 'Aeroporto di Caselle', m: '17 km', p: '30 min in treno', pEn: '30 min by train' },
];

const FAQ = [
  { q: 'Posso arrivare dopo le 23?', qEn: 'Can I arrive after 11 pm?',
    a: 'Sì. La reception è presidiata fino alle 23, dopo di che vi mandiamo il codice del portone e la chiave è in cassetta. Ditecelo il giorno prima.',
    aEn: 'Yes. Reception is staffed until 11 pm; after that we send you the door code and the key is in the box. Just let us know the day before.' },
  { q: 'Come si cancella una prenotazione?', qEn: 'How do I cancel a booking?',
    a: 'Prenotando qui: gratis fino a 3 giorni prima dell’arrivo, senza carta bloccata. Basta un messaggio.',
    aEn: 'Booking here: free of charge up to 3 days before arrival, with no card pre-authorisation. A message is enough.' },
  { q: 'C’è la culla per il bambino?', qEn: 'Is a cot available for a baby?',
    a: 'Sì, gratuita fino a 2 anni: due culle disponibili, meglio chiederle in anticipo. I bambini fino a 12 anni dormono nel letto dei genitori senza supplemento.',
    aEn: 'Yes, free up to 2 years: we have two cots, better to request in advance. Children up to 12 sleep in their parents’ bed at no extra cost.' },
  { q: 'La colazione va bene per celiaci o vegani?', qEn: 'Is breakfast coeliac or vegan friendly?',
    a: 'Sì, ma avvisateci prima: compriamo la mattina e prepariamo a parte, su un piano dedicato.',
    aEn: 'Yes, but tell us in advance: we shop in the morning and prepare separately, on a dedicated surface.' },
  { q: 'Quanto costa la tassa di soggiorno?', qEn: 'How much is the city tax?',
    a: '3,00 € a persona per notte, per un massimo di 7 notti. Non è inclusa nel prezzo della camera e si paga qui, in contanti o con carta. Non la prendiamo noi: la giriamo al Comune.',
    aEn: '€3.00 per person per night, for a maximum of 7 nights. It is not included in the room rate and is paid here, by cash or card. We do not keep it: it goes to the City.' },
];

const RECENSIONI = [
  { t: 'Camera piccola ma silenziosissima, e la colazione è di quelle vere. Ci torniamo.', tEn: 'Small room but incredibly quiet, and breakfast is the real thing. We’ll be back.', a: 'Chiara, Milano' },
  { t: 'Siamo arrivati a mezzanotte e mezza e hanno lasciato la luce accesa e le indicazioni sul tavolo.', tEn: 'We arrived at half past midnight and they had left the light on and directions on the table.', a: 'Thomas, München' },
  { t: 'Prenotato dal loro sito: 22 € in meno a notte rispetto a Booking, stessa camera.', tEn: 'Booked on their site: €22 less per night than Booking, same room.', a: 'Luca, Genova' },
];

const TEL = '011 000 0000';
const TEL_HREF = '+390110000000';
const WA = 'https://wa.me/390110000000';
const INDIRIZZO = 'Via Verdi 12, Torino';
const MAPPA = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(INDIRIZZO);
---
<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>Albergo del Teatro — Hotel in centro a Torino · Prenota diretto</title>
  <meta name="description" content="Albergo del Teatro: 18 camere in un palazzo dell’Ottocento a 200 metri dalla Mole. Colazione inclusa, cancellazione gratuita e il prezzo migliore prenotando direttamente." />
  <meta name="theme-color" content="#0f241d" />
  <link rel="preload" as="font" type="font/woff2" href={cormorantWoff2} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={jostWoff2} crossorigin />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><rect width='24' height='24' rx='5' fill='%230f241d'/><path d='M7 17V8m0 4.5h5M12 17V8' stroke='%23d8bd7a' stroke-width='1.9' stroke-linecap='round' fill='none'/><circle cx='16.5' cy='9' r='1.3' fill='%23d8bd7a'/></svg>" />
</head>
<body>

  <a class="demo-flag" href="/siti-web-hotel-torino">★ Demo di <b>Mole Digitale</b> <span class="flag-lungo">· Vuoi un sito così per il tuo hotel?</span> · <b>Scopri di più →</b></a>

  <!-- NAV -->
  <header class="hnav" id="hnav">
    <a href="#top" class="hbrand">
      <span class="hbrand-m" aria-hidden="true">T</span>
      <span class="hbrand-t">Albergo <em>del Teatro</em></span>
    </a>
    <nav class="hlinks" id="hlinks" aria-label="Menu">
      <a href="#camere" data-en="Rooms">Camere</a>
      <a href="#servizi" data-en="Services">Servizi</a>
      <a href="#dove" data-en="Location">Dove siamo</a>
      <a href="#domande" data-en="FAQ">Domande</a>
      <a href="#prenota" class="solo-mobile" data-en="Book">Prenota</a>
    </nav>
    <div class="hnav-dx">
      <div class="lingua" role="group" aria-label="Lingua / Language">
        <button type="button" class="lng on" data-lng="it" aria-pressed="true">IT</button>
        <button type="button" class="lng" data-lng="en" aria-pressed="false">EN</button>
      </div>
      <button class="hnav-toggle" id="navToggle" aria-label="Apri il menu" aria-expanded="false" aria-controls="hlinks">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
      <a href="#prenota" class="hbtn hbtn-oro" data-en="Book">Prenota</a>
    </div>
  </header>

  <main id="main">

  <!-- HERO + MOTORE DI PRENOTAZIONE -->
  <section class="hero" id="top">
    <div class="hero-in">
      <p class="occhiello r" data-en="18 rooms in the centre of Turin · since 1954">18 camere nel centro di Torino · dal 1954</p>
      <h1 class="hero-t r">
        <span data-en="Two hundred metres">Duecento metri</span><br/>
        <span class="it" data-en="from the Mole.">dalla Mole.</span>
      </h1>
      <p class="hero-s r" data-en="A nineteenth-century building, a lift that creaks a little, and breakfast served at the table. Book here and you pay less than anywhere else: no commission in between.">Un palazzo dell’Ottocento, un ascensore che cigola un po’, e la colazione servita al tavolo. Prenotate qui e pagate meno che altrove: in mezzo non c’è nessuna commissione.</p>

      <!-- Il motore: sta in cima perché è il lavoro numero uno del sito -->
      <div class="motore r" id="prenota">
        <div class="mot-campi">
          <label><span data-en="Check-in">Arrivo</span><input type="date" id="dataIn" /></label>
          <label><span data-en="Check-out">Partenza</span><input type="date" id="dataOut" /></label>
          <label><span data-en="Guests">Ospiti</span>
            <select id="ospiti">
              <option value="1">1</option><option value="2" selected>2</option>
              <option value="3">3</option><option value="4">4</option>
            </select>
          </label>
          <label><span data-en="Room">Camera</span>
            <select id="tipo">
              {CAMERE.map((c) => <option value={c.k} data-en={c.en} selected={c.k === 'matrimoniale'}>{c.n}</option>)}
            </select>
          </label>
          <button type="button" class="hbtn hbtn-oro mot-btn" id="calcola" data-en="See the price">Vedi il prezzo</button>
        </div>
        <p class="mot-err" id="motErr" role="alert" hidden></p>
      </div>

      <!-- Esito del preventivo -->
      <div class="esito r" id="esito" hidden>
        <div class="es-testa">
          <div>
            <span class="es-et" id="esEt">Il vostro soggiorno</span>
            <p class="es-riga" id="esRiga"></p>
          </div>
          <div class="es-prezzo">
            <b id="esTot">—</b>
            <span id="esNotti"></span>
          </div>
        </div>
        <ul class="es-voci" id="esVoci"></ul>
        <div class="es-conf" id="esConf">
          <div>
            <span class="es-conf-et" id="esConfEt">Sullo stesso portale di prenotazione</span>
            <p class="es-conf-p" id="esConfP"></p>
          </div>
          <b class="es-risp" id="esRisp"></b>
        </div>
        <div class="es-azioni">
          <a class="hbtn hbtn-wa" id="esWa" href={WA} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 1 1 12 20zm4.5-6c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1-.6.8-.8 1-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.6-1.2.1-.1 0-.3 0-.4l-.7-1.7c-.2-.5-.4-.4-.5-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4c2.3 1 2.3.7 2.7.6a2.5 2.5 0 0 0 1.6-1.1 2 2 0 0 0 .1-1.1z"/></svg>
            <span data-en="Request these dates">Richiedi queste date</span>
          </a>
          <a class="hbtn hbtn-filo" href={'tel:' + TEL_HREF} data-en={'Call ' + TEL}>Chiama {TEL}</a>
        </div>
        <p class="es-nota" id="esNota">Demo: nessuna prenotazione viene registrata. Sul sito vero la richiesta arriva in reception e la disponibilità è quella reale del gestionale.</p>
      </div>
    </div>
  </section>

  <!-- PERCHÉ DIRETTO -->
  <section class="banda-oro">
    <div class="misura oro-in">
      <h2 class="sr-only" data-en="Why book direct">Perché prenotare diretto</h2>
      <div class="oro-p"><b data-en="No commission">Zero commissioni</b><span data-en="What you would pay to the portal stays in your pocket.">Quello che dareste al portale resta nelle vostre tasche.</span></div>
      <div class="oro-p"><b data-en="Free cancellation">Cancellazione gratuita</b><span data-en="Up to 3 days before, without blocking your card.">Fino a 3 giorni prima, senza bloccare la carta.</span></div>
      <div class="oro-p"><b data-en="Best room available">La camera migliore</b><span data-en="Of that type, we assign the best one to those who book direct.">Fra quelle di quel tipo, a chi prenota diretto diamo la migliore.</span></div>
    </div>
  </section>

  <!-- CAMERE -->
  <section class="sez" id="camere">
    <div class="misura">
      <div class="testa">
        <span class="kicker r" data-en="The rooms">Le camere</span>
        <h2 class="r"><span data-en="Eighteen, and no two">Diciotto, e non ce ne sono</span> <span class="it" data-en="are alike.">due uguali.</span></h2>
        <p class="lead r" data-en="Prices are per room per night, breakfast included. City tax is separate.">I prezzi sono per camera, a notte, colazione inclusa. La tassa di soggiorno è a parte.</p>
      </div>

      <div class="camere">
        {CAMERE.map((c) => (
          <article class="camera r" data-camera={c.k}>
            <div class="cam-testa">
              <h3 data-en={c.en}>{c.n}</h3>
              <p class="cam-da"><span data-en="from">da</span> <b>{c.base} €</b></p>
            </div>
            <p class="cam-d" data-en={c.dEn}>{c.d}</p>
            <ul class="cam-dati">
              <li><span data-en="Size">Superficie</span><b>{c.mq} m²</b></li>
              <li><span data-en="Beds">Letti</span><b data-en={c.lettiEn}>{c.letti}</b></li>
              <li><span data-en="Sleeps">Ospiti</span><b>{c.max}</b></li>
            </ul>
            <button type="button" class="cam-btn" data-scegli={c.k} data-en="Check dates →">Verifica le date →</button>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVIZI -->
  <section class="sez sez-chiara" id="servizi">
    <div class="misura">
      <div class="testa">
        <span class="kicker r" data-en="Included">Compreso nel prezzo</span>
        <h2 class="r"><span data-en="The things that">Le cose che</span> <span class="it" data-en="actually matter.">contano davvero.</span></h2>
      </div>
      <div class="serv">
        {SERVIZI.map((s) => (
          <div class="serv-c r"><b data-en={s.tEn}>{s.t}</b><span data-en={s.dEn}>{s.d}</span></div>
        ))}
      </div>
    </div>
  </section>

  <!-- DOVE -->
  <section class="sez" id="dove">
    <div class="misura dove-in">
      <div class="r">
        <span class="kicker" data-en="Where we are">Dove siamo</span>
        <h2 class="dove-h">{INDIRIZZO}</h2>
        <p class="dove-p" data-en="In the quadrilatero, on a street where cars barely pass. Everything worth seeing in Turin is within a twenty-minute walk — and the tram stop is right outside.">Nel quadrilatero, in una via dove le auto quasi non passano. Tutto quello che a Torino vale la pena vedere è a meno di venti minuti a piedi — e la fermata del tram è davanti al portone.</p>
        <div class="dove-azioni">
          <a href={MAPPA} target="_blank" rel="noopener" class="hbtn hbtn-oro" data-en="Open in Google Maps">Apri in Google Maps</a>
          <a href={'tel:' + TEL_HREF} class="hbtn hbtn-filo">{TEL}</a>
        </div>
      </div>
      <div class="r">
        <h3 class="h3" data-en="Walking distance">A piedi da qui</h3>
        <ul class="vicino">
          {VICINO.map((v) => (
            <li><span>{v.l}</span><b>{v.m}</b><i data-en={v.pEn}>{v.p}</i></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- RECENSIONI -->
  <section class="banda-scura">
    <div class="misura">
      <h2 class="sr-only" data-en="Reviews">Recensioni</h2>
      <div class="rece">
        {RECENSIONI.map((r) => (
          <figure class="rec r">
            <blockquote data-en={r.tEn}>{r.t}</blockquote>
            <figcaption>{r.a}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- DOMANDE -->
  <section class="sez sez-chiara" id="domande">
    <div class="misura stretta">
      <div class="testa">
        <span class="kicker r" data-en="FAQ">Domande frequenti</span>
        <h2 class="r"><span data-en="What people ask us">Quello che ci chiedete</span> <span class="it" data-en="on the phone.">al telefono.</span></h2>
      </div>
      <div class="faq">
        {FAQ.map((f, i) => (
          <details class="dom r" open={i === 0}>
            <summary data-en={f.qEn}>{f.q}</summary>
            <p data-en={f.aEn}>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  </main>

  <footer class="hfoot">
    <div class="misura hfoot-in">
      <span>Albergo del Teatro · {INDIRIZZO} · {TEL}</span>
      <span>Demo · <a href="/">Mole Digitale</a></span>
    </div>
  </footer>

  <a class="wa-fab" href={WA} target="_blank" rel="noopener" aria-label="WhatsApp">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 1 1 12 20zm4.5-6c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1-.6.8-.8 1-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.6-1.2.1-.1 0-.3 0-.4l-.7-1.7c-.2-.5-.4-.4-.5-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.9 11.9 0 0 0 4.6 4c2.3 1 2.3.7 2.7.6a2.5 2.5 0 0 0 1.6-1.1 2 2 0 0 0 .1-1.1z"/></svg>
  </a>

  <style is:global>
    :root{
      --bosco:#0f241d; --bosco-2:#143029; --panna:#f6f2ea; --carta:#fffdf8;
      --inchiostro:#132019; --grigio:#4d6157; --ottone:#836618; --ottone-c:#d8bd7a;
      --filo:rgba(19,32,25,.14); --filo-c:rgba(246,242,234,.16); --muted-c:#a9bbb1;
      --disp:'Cormorant Variable',Georgia,serif;
      --sans:'Jost Variable',system-ui,sans-serif;
      --e:cubic-bezier(.16,1,.3,1);
    }
    *{margin:0;padding:0;box-sizing:border-box}
    [hidden]{display:none !important}
    html{scroll-behavior:smooth;overflow-x:clip;scroll-padding-top:110px}
    @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
    body{background:var(--panna);color:var(--inchiostro);font-family:var(--sans);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
    img,svg{display:block;max-width:100%}
    a{color:inherit;text-decoration:none}
    button,input,select{font:inherit;color:inherit}
    h1,h2,h3{font-family:var(--disp);font-weight:600;line-height:1.05;letter-spacing:-.01em}
    .it{font-style:italic;color:var(--ottone)}
    .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    :focus-visible{outline:2px solid var(--ottone-c);outline-offset:3px;border-radius:3px}
    .misura{max-width:1140px;margin:0 auto;padding-inline:clamp(1.2rem,5vw,3rem)}
    .misura.stretta{max-width:820px}

    .demo-flag{position:fixed;top:0;left:0;right:0;z-index:200;text-align:center;font-size:.8rem;line-height:1.4;
      padding:.4rem .6rem;background:rgba(9,20,16,.94);backdrop-filter:blur(8px);color:#cfdbd4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .flag-lungo{display:inline}
    @media (max-width:640px){.flag-lungo{display:none}}
    .demo-flag b{color:var(--ottone-c)}
    .wa-fab{position:fixed;right:18px;bottom:18px;z-index:160;width:52px;height:52px;border-radius:50%;display:grid;place-items:center;background:#25d366;color:#fff;box-shadow:0 14px 30px -10px rgba(37,211,102,.6);transition:transform .2s var(--e)}
    .wa-fab:hover{transform:scale(1.08)}

    /* NAV */
    .hnav{position:fixed;top:31px;left:0;right:0;z-index:150;display:flex;align-items:center;gap:1.4rem;
      padding:1rem clamp(1.2rem,5vw,3rem);color:var(--panna);transition:.35s var(--e)}
    .hnav.solid{background:rgba(15,36,29,.92);backdrop-filter:blur(14px);border-bottom:1px solid var(--filo-c);padding-block:.6rem}
