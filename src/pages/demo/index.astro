---
import Layout from '../../layouts/Layout.astro';

// Le anteprime sono SCREENSHOT reali di ogni demo (public/img/thumbs/<key>.webp), 16:10.
// `cerca` = parole con cui la gente descrive la propria attività: la ricerca cerca lì dentro,
// così chi ha un bar trova la demo scrivendo "colazione" o "caffè", non solo "bar".
const demos = [
  { k: 'ristorante',   name: 'Trattoria del Sole', cat: 'Ristorante',        url: '/demo/ristorante',   desc: 'Menu digitale + prenotazione tavolo',
    cerca: 'ristorante trattoria osteria locale cucina piatti menu tavolo prenotazione cena pranzo mangiare' },
  { k: 'salone',       name: 'Salone Aurora',      cat: 'Parrucchiere',      url: '/demo/salone',       desc: 'Prenotazione appuntamenti online',
    cerca: 'parrucchiere parrucchiera capelli barbiere taglio piega colore tinta acconciatura salone hair' },
  { k: 'officina',     name: 'Garage Rossi',       cat: 'Officina',          url: '/demo/officina',     desc: 'Sito vetrina + scheda Google',
    cerca: 'officina meccanico auto automobile gomme gommista pneumatici tagliando revisione carrozzeria riparazione motori furgone' },
  { k: 'addestratore', name: 'Coda Felice',        cat: 'Addestratore cani', url: '/demo/addestratore', desc: 'Percorsi + configuratore + prova gratuita',
    cerca: 'addestratore cani cane educatore cinofilo dog sitter pensione animali cuccioli' },
  { k: 'estetica',     name: 'Velvèe',             cat: 'Centro estetico',   url: '/demo/estetica',     desc: 'Trattamenti in carosello + prenotazione',
    cerca: 'estetista centro estetico bellezza trattamenti viso corpo ceretta epilazione beauty' },
  { k: 'farmacia',     name: 'Farmacia Aurora',    cat: 'Farmacia',          url: '/demo/farmacia',     desc: 'Orari live + servizi in lista',
    cerca: 'farmacia parafarmacia medicinali farmaci salute sanitaria turni' },
  { k: 'dentista',     name: 'Studio Sorriso',     cat: 'Dentista',          url: '/demo/dentista',     desc: 'Prima visita gratuita + trattamenti a tab',
    cerca: 'dentista odontoiatra studio dentistico denti igiene implantologia ortodonzia apparecchio' },
  { k: 'profumeria',   name: 'Essènza',            cat: 'Profumeria',        url: '/demo/profumeria',   desc: 'Consulenza olfattiva + indice fragranze',
    cerca: 'profumeria profumi fragranze essenze cosmetici make up trucco' },
  { k: 'massaggi',     name: 'Sàva',               cat: 'Centro massaggi',   url: '/demo/massaggi',     desc: 'Massaggi in accordion con durate e prezzi',
    cerca: 'massaggi massaggiatore benessere spa relax olistico thai decontratturante contratture schiena cervicale' },
  { k: 'osteopata',    name: 'Àsse',               cat: 'Osteopatia',        url: '/demo/osteopata',    desc: 'Per chi è + percorso a timeline',
    cerca: 'osteopata osteopatia fisioterapista fisioterapia chiropratico mal di schiena dolore lombalgia sciatica cervicale postura riabilitazione' },
  { k: 'viaggi',       name: 'Vàgo',               cat: 'Agenzia viaggi',    url: '/demo/viaggi',       desc: 'Hero con ricerca + destinazioni bento',
    cerca: 'agenzia viaggi vacanze tour operator voli crociere biglietteria turismo pacchetti' },
  { k: 'nails',        name: 'Lúnula',             cat: 'Nail studio',       url: '/demo/nails',        desc: 'Listino + gallery masonry di nail art',
    cerca: 'nail unghie manicure pedicure ricostruzione gel semipermanente nail art onicotecnica' },
  { k: 'animali',      name: 'Zampe Amiche',       cat: 'Veterinario',       url: '/demo/animali',      desc: 'Servizi + urgenze 24/7 + prenotazione',
    cerca: 'veterinario veterinaria animali cani gatti clinica ambulatorio toelettatura' },
  { k: 'lavanderia',   name: 'Bollé',              cat: 'Lavanderia',        url: '/demo/lavanderia',   desc: 'Come funziona + listino + ritiro a domicilio',
    cerca: 'lavanderia lavasecco stireria tintoria bucato capi sartoria' },
  { k: 'sushi',        name: 'Hashi',              cat: 'Sushi',             url: '/demo/sushi',        desc: 'Menu giapponese + omakase + prenotazione',
    cerca: 'sushi giapponese asiatico poke sashimi ramen ristorante fusion' },
  { k: 'ecommerce',    name: 'Bottega Subalpina',  cat: 'E-commerce',        url: '/demo/ecommerce',    desc: 'Negozio online con carrello',
    cerca: 'ecommerce e-commerce negozio online shop carrello vendere prodotti spedizioni alimentari' },
  { k: 'museo-egizio', name: 'Museo Egizio',       cat: 'Cultura',           url: '/demo/museo-egizio', desc: 'Sito museale + biglietti online',
    cerca: 'museo cultura mostra esposizione biglietti arte turismo visite guidate' },
  { k: 'compro-oro',   name: 'Aureo',              cat: 'Compro Oro',        url: '/demo/compro-oro',   desc: 'Calcolo valore oro in tempo reale',
    cerca: 'compro oro usato valutazione argento monete preziosi quotazione' },
  { k: 'gioielleria',  name: 'Lùmina',             cat: 'Gioielleria',       url: '/demo/gioielleria',  desc: 'Collezioni, preferiti e fede su misura',
    cerca: 'gioielleria gioielli anelli fedi nuziali collane oro argento diamanti orafo' },
  { k: 'orologiaio',   name: 'Cronos',             cat: 'Orologiaio',        url: '/demo/orologiaio',   desc: 'Orologio live + preventivo riparazione',
    cerca: 'orologiaio orologi orologeria riparazione batteria revisione cinturino vintage' },
  { k: 'bar',          name: 'Caffè Portici',      cat: 'Bar e caffetteria', url: '/demo/bar',          desc: 'Il sito cambia con l’ora + ordina e ritira',
    cerca: 'bar caffetteria caffè colazione brioche cappuccino aperitivo spritz pranzo tavola calda pasticceria' },
  { k: 'hotel',        name: 'Albergo del Teatro', cat: 'Hotel',             url: '/demo/hotel',        desc: 'Preventivo per date + prenotazione diretta, IT/EN',
    cerca: 'hotel albergo bed and breakfast b&b affittacamere pensione locanda camere ospiti turisti prenotazione booking notte soggiorno' },
];

// Scorciatoie sotto il campo: i settori più cercati.
const scorciatoie = ['bar', 'ristorante', 'parrucchiere', 'dentista'];
---
<Layout title="Demo — esempi di siti | Mole Digitale" description="Esempi veri di siti Mole Digitale per attività di Torino: ristoranti, bar, parrucchieri, officine, farmacie, dentisti, estetica e molti altri settori.">
  <section class="section" style="padding-top:8rem;">
    <div class="section-head" data-reveal>
      <span class="kicker">Demo</span>
      <h1>Esempi di siti che <span class="grad">facciamo</span>.</h1>
      <p class="section-lead">Ventidue attività, ventidue stili diversi — ogni sito ha una sua struttura. Aprili e prova a cliccare: prenotazioni, menu, carrello, calcolatori e preventivi che funzionano davvero.</p>
    </div>

    <!-- RICERCA -->
    <div class="cerca" data-reveal>
      <div class="cerca-campo">
        <svg class="cerca-lente" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" id="cercaDemo" placeholder="Che attività hai? bar, parrucchiere, officina…"
               autocomplete="off" enterkeyhint="search" aria-label="Cerca fra le demo per settore" />
        <button type="button" class="cerca-x" id="cercaX" hidden aria-label="Cancella la ricerca">✕</button>
      </div>
      <div class="cerca-sotto">
        <p class="cerca-sugg">
          <span>Più cercati:</span>
          {scorciatoie.map((s) => <button type="button" class="cerca-tag" data-tag={s}>{s}</button>)}
        </p>
        <p class="cerca-esito" id="cercaEsito" role="status" aria-live="polite">{demos.length} demo</p>
      </div>
    </div>

    <div class="port-grid" id="portGrid">
      {demos.map((dm) => (
        <a class="port-card glass" href={dm.url} data-reveal data-tilt
           data-forte={`${dm.name} ${dm.cat}`}
           data-cerca={`${dm.name} ${dm.cat} ${dm.desc} ${dm.cerca}`}>
          <div class="port-thumb">
            <img class="port-img" src={`/img/thumbs/${dm.k}.webp`} alt={`Anteprima del sito demo ${dm.name}`} loading="lazy" width="760" height="475" />
            <span class="port-go">Apri la demo →</span>
          </div>
          <div class="port-cap"><b>{dm.name}</b><span>{dm.cat} · {dm.desc}</span></div>
        </a>
      ))}
    </div>

    <div class="cerca-vuoto glass" id="cercaVuoto" hidden>
      <b>Nessuna demo per «<span id="cercaTermine"></span>»</b>
      <p>Non abbiamo ancora un esempio per questo settore — ma il sito lo facciamo lo stesso, cucito sulla tua attività. Raccontacela e ti mostriamo come lo imposteremmo.</p>
      <a href="/#contatti" class="btn btn-primary">Parliamone →</a>
    </div>

    <div style="text-align:center; margin-top:3rem;" data-reveal>
      <a href="/#contatti" class="btn btn-primary btn-magnetic btn-lg">Voglio un sito così →</a>
    </div>
  </section>

  <style>
    .cerca{max-width:640px;margin:0 auto 2.6rem}
    .cerca-campo{display:flex;align-items:center;gap:.7rem;background:var(--surface);border:1px solid var(--border);
      border-radius:999px;padding:.15rem .5rem .15rem 1.1rem;transition:border-color .3s var(--ease),background .3s}
    .cerca-campo:focus-within{border-color:rgba(124,92,255,.6);background:var(--surface-2)}
    .cerca-lente{color:var(--muted-2);flex:none}
    .cerca-campo input{flex:1;min-width:0;background:none;border:0;outline:none;color:var(--text);
      font:inherit;font-size:1rem;padding:.95rem 0}
    .cerca-campo input::placeholder{color:var(--muted-2)}
    .cerca-campo input::-webkit-search-cancel-button{display:none}
    .cerca-x{flex:none;width:34px;height:34px;border-radius:50%;border:0;background:var(--surface-2);color:var(--muted);
      cursor:pointer;font-size:.85rem;line-height:1;transition:background .25s,color .25s}
    .cerca-x:hover{background:rgba(255,255,255,.14);color:var(--text)}

    .cerca-sotto{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-top:.9rem;padding-inline:.4rem}
    .cerca-sugg{display:flex;align-items:center;gap:.45rem;flex-wrap:wrap;font-size:.85rem;color:var(--muted-2)}
    .cerca-tag{background:var(--surface);border:1px solid var(--border);border-radius:999px;padding:.25rem .7rem;
      color:var(--muted);font:inherit;font-size:.82rem;cursor:pointer;transition:.25s var(--ease)}
    .cerca-tag:hover{border-color:rgba(124,92,255,.55);color:var(--text);transform:translateY(-1px)}
    .cerca-esito{font-size:.85rem;color:var(--muted-2);white-space:nowrap}

    /* .port-card ha display:block nel global: serve più specificità per nasconderla */
    .port-card[hidden]{display:none}

    .cerca-vuoto{max-width:560px;margin:1rem auto 0;text-align:center;padding:2.4rem 1.8rem;border-radius:var(--radius)}
    .cerca-vuoto b{display:block;font-size:1.25rem;margin-bottom:.6rem}
    .cerca-vuoto p{color:var(--muted);margin-bottom:1.4rem}

    @media (max-width:560px){
      .cerca-sotto{justify-content:center;text-align:center}
      .cerca-sugg{justify-content:center}
    }
  </style>

  <script>
    const campo = document.getElementById('cercaDemo');
    const griglia = document.getElementById('portGrid');
    const schede = [...griglia.querySelectorAll('.port-card')];
    const esito = document.getElementById('cercaEsito');
    const vuoto = document.getElementById('cercaVuoto');
    const bottoneX = document.getElementById('cercaX');

    // «Caffè» si deve trovare anche scrivendo «caffe», e «più» scrivendo «piu».
    const piatto = (s) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    // Parole di servizio: chi scrive «mal di schiena» non deve trovare zero risultati per colpa del «di».
    const SERVIZIO = new Set(['di', 'del', 'dello', 'della', 'dei', 'degli', 'delle', 'il', 'lo', 'la', 'i', 'gli', 'le',
      'un', 'uno', 'una', 'e', 'a', 'ad', 'da', 'in', 'su', 'per', 'con', 'al', 'allo', 'alla', 'ai', 'agli', 'alle',
      'che', 'mio', 'mia', 'sito', 'siti']);

    // Tre indici: il testo intero, le sue parole singole, e quello "forte" (nome + settore).
    const indice = schede.map((s) => piatto(s.dataset.cerca || ''));
    const parole = schede.map((s) => new Set(piatto(s.dataset.cerca || '').split(/[^a-z0-9]+/).filter(Boolean)));
    const indiceForte = schede.map((s) => piatto(s.dataset.forte || ''));

    function filtra(q) {
      const termini = piatto(q).split(/\s+/).filter(Boolean).filter((t) => !SERVIZIO.has(t));

      // Chi cerca «bar» non vuole il barbiere. Quindi: se qualche demo combacia per PAROLA INTERA,
      // mostro solo quelle; il match parziale resta come rete di sicurezza mentre si sta digitando
      // (così «par», che non è una parola di nessuno, trova comunque il parrucchiere).
      const esatte = schede.map((s, i) => termini.every((t) => parole[i].has(t)));
      const larghe = schede.map((s, i) => termini.every((t) => indice[i].includes(t)));
      const preciso = esatte.some(Boolean);

      let trovate = 0;
      schede.forEach((s, i) => {
        const ok = preciso ? esatte[i] : larghe[i];
        s.hidden = !ok;
        if (!ok) { s.style.order = ''; return; }
        trovate++;
        // A parità di pertinenza, chi combacia nel nome o nel settore va prima.
        const punti = termini.filter((t) => indiceForte[i].includes(t)).length;
        s.style.order = String(-punti);
      });

      bottoneX.hidden = q.trim() === '';
      vuoto.hidden = trovate > 0;
      document.getElementById('cercaTermine').textContent = q.trim();
      esito.textContent = termini.length === 0
        ? `${schede.length} demo`
        : trovate === 0 ? 'Nessun risultato'
        : trovate === 1 ? '1 demo trovata' : `${trovate} demo trovate`;
    }

    campo.addEventListener('input', () => filtra(campo.value));
    campo.addEventListener('keydown', (e) => { if (e.key === 'Escape') { campo.value = ''; filtra(''); } });
    bottoneX.addEventListener('click', () => { campo.value = ''; filtra(''); campo.focus(); });
    document.querySelectorAll('.cerca-tag').forEach((b) => b.addEventListener('click', () => {
      campo.value = b.dataset.tag; filtra(campo.value); campo.focus();
    }));

    // Arrivo da un link tipo /demo/?q=bar (utile nelle campagne e nei link interni)
    const q = new URLSearchParams(location.search).get('q');
    if (q) { campo.value = q; filtra(q); }
  </script>
</Layout>
