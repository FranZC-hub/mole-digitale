---
// ══════════════════════════════════════════════════════════════════
// CASO STUDIO MASGIOIELLI — BOZZA, NON PUBBLICATA (il «_» davanti al nome la tiene fuori dal sito)
// Per pubblicarla, quando il sito del negozio è online da 2-3 mesi:
//   1. permesso scritto del negozio a usare nome, sito e una loro frase;
//   2. url vero, copertina (screenshot in /public/img/lavori/masgioielli/), 2-4 numeri VERI
//      (richieste dal sito, posizione su Google, giorni di lavoro), la frase del titolare;
//   3. rinomina il file in lavori/masgioielli.astro e linkalo dalla home e da
//      /siti-web-gioiellerie-torino/.
// Problema e soluzione sono già scritti sui fatti del progetto (docs/masgioielli/).
// ══════════════════════════════════════════════════════════════════
import Layout from '../../layouts/Layout.astro';

const c = {
  nome: 'MasGioielli',
  settore: 'Gioielleria e laboratorio orafo',
  zona: 'Torino — Corso Trapani',
  url: '',                                   // DA METTERE: l'indirizzo del sito online (masgioielli.it?)
  copertina: '/img/lavori/masgioielli/copertina.webp', // DA FARE: screenshot del sito online
  problema: 'Una gioielleria di quartiere aperta dal 1996, con un laboratorio orafo, un servizio di compro oro e le perizie: tanti servizi diversi, ma online quasi niente che li raccontasse, e nessun modo per il negozio di far vedere i nuovi pezzi senza chiedere a qualcuno.',
  soluzione: 'Un sito che racconta il negozio e il laboratorio, con una pagina per ogni servizio (atelier, compro oro, perizie), la selezione dei pezzi in vetrina e un’area riservata da cui il negozio carica le foto dei nuovi gioielli dal telefono, aggiorna orari e chiusure e gestisce i marchi. Testi rivisti con il titolare, veloce e accessibile.',
  risultati: [                               // DA RIEMPIRE con numeri VERI e il periodo
    { n: '—', l: 'richieste al mese dal sito' },
    { n: '—', l: 'su Google per «gioielleria Corso Trapani»' },
    { n: '—', l: 'giorni dalla firma alla messa online' },
  ],
  quote: '',                                 // DA METTERE: una frase vera del titolare, con il suo permesso
  quoteFirma: '',
};
---
<Layout
  title={`${c.nome} — caso studio | Mole Digitale`}
  description={`Come abbiamo aiutato ${c.nome} (${c.settore}, ${c.zona}): il problema, la soluzione e i risultati misurati.`}
>
  <section class="section" style="padding-top:8rem;">
    <div class="section-head" data-reveal>
      <span class="kicker">{c.settore} · {c.zona}</span>
      <h1>{c.nome}: <span class="grad">la storia</span>.</h1>
    </div>

    <a class="cs-cover glass" href={c.url || '#'} target={c.url ? '_blank' : undefined} rel="noopener" data-reveal>
      <img src={c.copertina} alt={`Il sito di ${c.nome}`} loading="lazy" width="900" height="560" />
    </a>

    <div class="cs-grid" data-reveal>
      <article class="prob-card"><h3>Il problema</h3><p>{c.problema}</p></article>
      <article class="prob-card"><h3>La soluzione</h3><p>{c.soluzione}</p></article>
    </div>

    <div class="numeri-grid" data-reveal style="margin-top:2rem;">
      {c.risultati.map((r) => (
        <div class="num-item"><b>{r.n}</b><span>{r.l}</span></div>
      ))}
    </div>

    <blockquote class="cs-quote glass" data-reveal>
      <p>«{c.quote}»</p>
      <footer>— {c.quoteFirma}</footer>
    </blockquote>

    <div style="text-align:center; margin-top:3rem;" data-reveal>
      <a href="/#contatti" class="btn btn-primary btn-magnetic btn-lg">Voglio un risultato così →</a>
    </div>
  </section>

  <style>
    .cs-cover { display:block; max-width:860px; margin:0 auto 2rem; padding:.8rem; }
    .cs-cover img { width:100%; height:auto; border-radius:12px; display:block; }
    .cs-grid { display:grid; grid-template-columns:1fr 1fr; gap:1.2rem; max-width:860px; margin:0 auto; }
    .cs-quote { max-width:680px; margin:2.5rem auto 0; padding:1.8rem 2rem; text-align:center; }
    .cs-quote p { font-size:1.15rem; font-style:italic; margin-bottom:.8rem; }
    .cs-quote footer { color:var(--muted); font-size:.92rem; }
    @media (max-width:700px){ .cs-grid { grid-template-columns:1fr; } }
  </style>
</Layout>
