---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
// Tempo di lettura, come nella pagina della guida (~200 parole al minuto)
const minuti = (corpo) => Math.max(1, Math.round((corpo ?? '').split(/\s+/).filter(Boolean).length / 200));
---
<Layout image="/og/guide.png" title="Guide su siti web e Google per attività | Mole Digitale" description="Guide pratiche per gli esercenti di Torino: siti vetrina, scheda Google Business, restyling, costi e prenotazioni online, spiegati senza giri di parole.">
  <section class="section section-alta">
    <div class="section-head" data-reveal>
      <span class="kicker">Guide</span>
      <h1>Guide pratiche, <span class="grad">senza giri di parole</span>.</h1>
      <p class="section-lead">Cose utili su siti web, Google e presenza online — spiegate semplici.</p>
    </div>
    <h2 class="sr-only">Tutte le guide</h2>
    <div class="blog-list">
      {posts.map((p) => (
        <a class="blog-card glass" href={`/blog/${p.id}/`} data-reveal>
          <h3>{p.data.title}</h3>
          <p>{p.data.description}</p>
          <span class="blog-piede"><span class="blog-more">Leggi la guida →</span><span class="blog-min">{minuti(p.body)} min di lettura</span></span>
        </a>
      ))}
    </div>
  </section>
  <style>
    /* due colonne su computer: 14 schede in fila in una colonna sola erano 4.000 px di elenco */
    .blog-list { display:grid; grid-template-columns:repeat(2,1fr); gap:1.4rem; max-width:1100px; margin:0 auto; }
    @media (max-width:860px){ .blog-list { grid-template-columns:1fr; max-width:820px; } }
    .blog-card { display:flex; flex-direction:column; padding:1.8rem; transition:transform .3s var(--ease), box-shadow .3s; }
    .blog-card:hover { transform:translateY(-5px); box-shadow:0 30px 60px -30px rgba(124,92,255,.4); }
    .blog-card time { color:var(--c2); font-size:.82rem; font-family:'Space Grotesk Variable','Space Grotesk'; }
    .blog-card h3 { font-size:1.4rem; margin:.5rem 0 .6rem; }
    .blog-card p { color:var(--muted); }
    /* il piede resta in fondo alla scheda anche quando la vicina ha più testo */
    .blog-piede { display:flex; justify-content:space-between; align-items:baseline; gap:1rem; flex-wrap:wrap; margin-top:auto; padding-top:1rem; }
    .blog-more { color:var(--c2); font-weight:600; }
    .blog-min { color:var(--muted-2); font-size:.86rem; }
  </style>
</Layout>
