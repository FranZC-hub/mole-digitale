# Mole Digitale — configurazione Apache (Aruba / hosting Linux)

# --- Header di sicurezza ---
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Forza HTTPS per un anno anche sui sottodomini (attivare solo con SSL attivo)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Tenuta stretta su quello che il sito usa DAVVERO oggi: in Layout.astro sia
  # cfAnalyticsToken sia clarityId sono vuoti, quindi né Cloudflare Insights né
  # Microsoft Clarity vengono caricati. Autorizzarli comunque regalava superficie
  # d'attacco a servizi spenti.
  # ⚠️ Se un giorno accendi uno dei due, rimetti gli host corrispondenti:
  #   Cloudflare Insights → script-src https://static.cloudflareinsights.com
  #                         connect-src https://cloudflareinsights.com
  #   Microsoft Clarity   → script-src https://www.clarity.ms
  #                         connect-src https://*.clarity.ms https://c.bing.com
  #                         img-src     https://*.clarity.ms https://c.bing.com
  # frame-src: senza, ricadeva su default-src 'self' e la mappa Google incorporata
  # in /demoFarmaciaAusiliatrice/dove-siamo/ veniva BLOCCATA — riquadro vuoto in una
  # bozza mostrata a un cliente. È l'unico iframe di tutto il sito.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-src https://www.google.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
</IfModule>

# --- Forza HTTPS e il www ---
# Oggi lo fa già il proxy di Aruba (ottobre 2026: http:// e senza www rispondono 301 su
# https://www.moledigitale.it/); questa regola resta come rete di sicurezza, in un solo 301.
#
# Il sito sta dietro un proxy (Server: aruba-proxy) che gestisce https: Apache crede di ricevere
# http, e i reindirizzamenti che costruisce da solo puntano a http:// (poi il proxy rimanda su
# https: due 301 invece di uno). Per questo qui sotto ogni destinazione è scritta per intero.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^moledigitale\.it$ [NC]
  RewriteRule ^ https://www.moledigitale.it%{REQUEST_URI} [L,R=301]

  # Cartella senza barra finale (/blog): Apache la aggiungerebbe mandando su http://.../blog/.
  # La aggiungiamo prima noi, dritti su https. (Le sottocartelle con un .htaccess proprio, come
  # /masgioielliDev/, non ereditano questa regola: lì resta il comportamento di Apache.)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+[^/])$ https://www.moledigitale.it/$1/ [L,R=301]
</IfModule>

# --- Pagina di errore 404 brandizzata ---
ErrorDocument 404 /404.html

# --- Proteggi i file di configurazione, i lead e le statistiche ---
# Di norma questi file stanno SOPRA la cartella pubblica (contact.php/stats.php scrivono in ../),
# quindi non sono raggiungibili dal web: questo blocco e' una rete di sicurezza se finissero qui.
<FilesMatch "^(mail-config.*\.php|leads\.csv|stats.*\.csv)$">
  Require all denied
</FilesMatch>

# --- La libreria PHPMailer non va servita dal web ---
# contact.php la carica dal disco con require: dall'esterno non deve essere
# raggiungibile. Prima /phpmailer/src/PHPMailer.php rispondeva 200 (pagina vuota,
# perché il file dichiara solo classi) — inoffensivo finché PHP funziona, ma se
# l'handler PHP salta durante una migrazione dell'hosting il sorgente diventa
# leggibile e regala la versione esatta della libreria a chi cerca bersagli.
<IfModule mod_alias.c>
  RedirectMatch 404 ^/phpmailer/
</IfModule>
<IfModule !mod_alias.c>
  <FilesMatch "^(PHPMailer|SMTP|Exception|POP3|OAuth.*|DSNConfigurator)\.php$">
    Require all denied
  </FilesMatch>
</IfModule>

# --- Bozza di MasGioielli tolta (27 ottobre 2026): la versione reale l'ha superata ---
# I vecchi indirizzi (il negozio ha quelli) portano alla pagina corrispondente in /masgioielliDev/.
# Vale anche se sul server la cartella /demoMasGioielli/ fosse ancora lì. Prima le regole precise,
# poi quella generale: vince la prima che corrisponde.
# Destinazioni complete in https: con un percorso relativo Apache scriveva http:// (vedi sopra).
<IfModule mod_alias.c>
  RedirectMatch 301 ^/demoMasGioielli/vetrina/?$ https://www.moledigitale.it/masgioielliDev/selezione/
  RedirectMatch 301 ^/demoMasGioielli/laboratorio/?$ https://www.moledigitale.it/masgioielliDev/atelier/
  RedirectMatch 301 ^/demoMasGioielli/riservata/?$ https://www.moledigitale.it/masgioielliDev/area-riservata/
  RedirectMatch 301 ^/demoMasGioielli/(compro-oro|perizie|contatti|privacy)/?$ https://www.moledigitale.it/masgioielliDev/$1/
  RedirectMatch 301 ^/demoMasGioielli(/.*)?$ https://www.moledigitale.it/masgioielliDev/
</IfModule>

# --- Compressione (riduce di ~70% HTML/CSS/JS in trasferimento) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
  # I font woff2 e le immagini sono gia' compressi: ricomprimerli non serve.
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/xml image/svg+xml
</IfModule>

# --- Cache asset statici ---
<IfModule mod_expires.c>
  ExpiresActive On
  # L'HTML cambia a ogni pubblicazione: cache breve + rivalidazione.
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/avif "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
  ExpiresByType image/vnd.microsoft.icon "access plus 6 months"
</IfModule>

# --- Asset con hash nel nome (/_astro/...): immutabili, cache lunghissima ---
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/_astro/" MD_IMMUTABLE
  Header set Cache-Control "public, max-age=31536000, immutable" env=MD_IMMUTABLE
</IfModule>
